@model GimnasioJena.Abstracciones.Modelos.HorariosSemanales.HorarioSemanalEditarDto

@{
    ViewBag.Title = "Editar programación semanal";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card-jena-info">

                <div class="card-header bg-white border-bottom">
                    <h1 class="page-title">
                        Editar programación semanal
                    </h1>

                    <p class="text-muted mb-0">
                        Modifique la información del horario seleccionado.
                    </p>
                </div>

                <div class="card-body">

                    @using (
                        Html.BeginForm(
                            "Editar",
                            "HorariosSemanales",
                            FormMethod.Post
                        )
                    )
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(
                            modelo => modelo.idHorario
                        )

                        @Html.ValidationSummary(
                            true,
                            "",
                            new
                            {
                                @class = "alert alert-danger"
                            }
                        )

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                @Html.LabelFor(
                                    modelo => modelo.idTipoClase,
                                    "Tipo de clase",
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                @Html.DropDownListFor(
                                    modelo => modelo.idTipoClase,
                                    ViewBag.TiposClase as SelectList,
                                    "Seleccione un tipo de clase",
                                    new
                                    {
                                        @class = "form-select"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    modelo => modelo.idTipoClase,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    }
                                )

                            </div>

                            <div class="col-md-6 mb-3">

                                @Html.LabelFor(
                                    modelo =>
                                        modelo.idUsuarioEntrenador,
                                    "Entrenador",
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                @Html.DropDownListFor(
                                    modelo =>
                                        modelo.idUsuarioEntrenador,
                                    ViewBag.Entrenadores as SelectList,
                                    "Seleccione un entrenador",
                                    new
                                    {
                                        @class = "form-select"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    modelo =>
                                        modelo.idUsuarioEntrenador,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    }
                                )

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                @Html.LabelFor(
                                    modelo => modelo.diaSemana,
                                    "Día de la semana",
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                @Html.DropDownListFor(
                                    modelo => modelo.diaSemana,
                                    new List<SelectListItem>
                                    {
                                        new SelectListItem
                                        {
                                            Value = "1",
                                            Text = "Lunes"
                                        },
                                        new SelectListItem
                                        {
                                            Value = "2",
                                            Text = "Martes"
                                        },
                                        new SelectListItem
                                        {
                                            Value = "3",
                                            Text = "Miércoles"
                                        },
                                        new SelectListItem
                                        {
                                            Value = "4",
                                            Text = "Jueves"
                                        },
                                        new SelectListItem
                                        {
                                            Value = "5",
                                            Text = "Viernes"
                                        },
                                        new SelectListItem
                                        {
                                            Value = "6",
                                            Text = "Sábado"
                                        },
                                        new SelectListItem
                                        {
                                            Value = "7",
                                            Text = "Domingo"
                                        }
                                    },
                                    "Seleccione un día",
                                    new
                                    {
                                        @class = "form-select"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    modelo => modelo.diaSemana,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    }
                                )

                            </div>

                            <div class="col-md-6 mb-3">

                                @Html.LabelFor(
                                    modelo => modelo.cupoMaximo,
                                    "Cupo máximo",
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                @Html.TextBoxFor(
                                    modelo => modelo.cupoMaximo,
                                    new
                                    {
                                        @class = "form-control",
                                        type = "number",
                                        min = "1",
                                        max = "30"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    modelo => modelo.cupoMaximo,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    }
                                )

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                @Html.LabelFor(
                                    modelo => modelo.horaInicio,
                                    "Hora de inicio",
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                @Html.TextBoxFor(
                                    modelo => modelo.horaInicio,
                                    "{0:hh\\:mm}",
                                    new
                                    {
                                        @class = "form-control",
                                        type = "time"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    modelo => modelo.horaInicio,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    }
                                )

                            </div>

                            <div class="col-md-6 mb-3">

                                @Html.LabelFor(
                                    modelo => modelo.horaFin,
                                    "Hora de finalización",
                                    new
                                    {
                                        @class = "form-label"
                                    }
                                )

                                @Html.TextBoxFor(
                                    modelo => modelo.horaFin,
                                    "{0:hh\\:mm}",
                                    new
                                    {
                                        @class = "form-control",
                                        type = "time"
                                    }
                                )

                                @Html.ValidationMessageFor(
                                    modelo => modelo.horaFin,
                                    "",
                                    new
                                    {
                                        @class = "text-danger"
                                    }
                                )

                            </div>

                        </div>

                        

                        <div class="mb-4">

                            <div class="form-check form-switch">

                                @Html.CheckBoxFor(
                                    modelo => modelo.estado,
                                    new
                                    {
                                        @class =
                                            "form-check-input"
                                    }
                                )

                                @Html.LabelFor(
                                    modelo => modelo.estado,
                                    "Horario activo",
                                    new
                                    {
                                        @class =
                                            "form-check-label"
                                    }
                                )

                            </div>

                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            @Html.ActionLink(
                                "Cancelar",
                                "Index",
                                null,
                                new
                                {
                                    @class =
                                        "btn btn-outline-secondary"
                                }
                            )

                            <button type="submit"
                                    class="btn btn-primary">

                                Guardar cambios

                            </button>

                        </div>
                    }

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}