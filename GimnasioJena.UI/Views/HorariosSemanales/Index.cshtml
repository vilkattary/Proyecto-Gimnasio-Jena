@model IEnumerable<GimnasioJena.Abstracciones.Modelos.HorariosSemanales.HorarioSemanalListadoDto>

@{
    ViewBag.Title = "Programación semanal";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var horarios = Model != null
        ? Model.ToList()
        : new List<GimnasioJena.Abstracciones.Modelos.HorariosSemanales.HorarioSemanalListadoDto>();

    var dias = horarios
        .GroupBy(h => new
        {
            h.diaSemana,
            h.nombreDia
        })
        .OrderBy(g => g.Key.diaSemana)
        .ToList();

    int indiceDia = 0;

    // Calcular la próxima fecha de cada día (diaSemana: 1=Lunes … 7=Domingo)
    // DayOfWeek: Sunday=0, Monday=1 … Saturday=6
    var mapDiaSemana = new System.Collections.Generic.Dictionary<int, System.DayOfWeek>
    {
        { 1, System.DayOfWeek.Monday    },
        { 2, System.DayOfWeek.Tuesday   },
        { 3, System.DayOfWeek.Wednesday },
        { 4, System.DayOfWeek.Thursday  },
        { 5, System.DayOfWeek.Friday    },
        { 6, System.DayOfWeek.Saturday  },
        { 7, System.DayOfWeek.Sunday    }
    };

    var mesesEs = new[]
    {
        "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
        "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
    };

    System.DateTime hoy = System.DateTime.Today;

    Func<int, System.DateTime> proximaFecha = (numDia) =>
    {
        if (!mapDiaSemana.ContainsKey(numDia)) { return hoy; }
        System.DayOfWeek objetivo = mapDiaSemana[numDia];
        int diff = ((int)objetivo - (int)hoy.DayOfWeek + 7) % 7;
        return hoy.AddDays(diff == 0 ? 0 : diff);
    };
}

<section class="horarios-page">

    

    <div class="container">
        <a href="javascript:history.back()" class="btn btn-volver" aria-label="Volver">
            <i class="bi bi-arrow-left"></i> Atrás
        </a>

        <div class="horarios-header">

            <div class="horarios-title-area">

                <div class="horarios-icon">
                    <i class="bi bi-calendar-week"></i>
                </div>

                <div class="horarios-title">
                    <h1 class="page-title">Programación semanal</h1>

                    <p>
                        Administre los horarios recurrentes utilizados
                        para generar las clases del gimnasio.
                    </p>
                </div>

            </div>

            @if (horarios.Any())
            {
                <div class="horarios-actions">

                    <a href="@Url.Action(
                        "Registrar",
                        "HorariosSemanales"
                    )"
                       class="btn btn-nueva-programacion">

                        <i class="bi bi-plus-circle me-2"></i>
                        Nueva programación
                    </a>

                </div>
            }
        </div>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["MensajeExito"]
            </div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["MensajeError"]
            </div>
        }

        @if (horarios.Any())
        {
            <div class="resumen-programacion">

                <div class="resumen-card">
                    <span>Total de horarios</span>
                    <strong>@horarios.Count</strong>
                </div>

                <div class="resumen-card activos">
                    <span>Horarios activos</span>
                    <strong>@horarios.Count(h => h.estado)</strong>
                </div>

                <div class="resumen-card inactivos">
                    <span>Horarios inactivos</span>
                    <strong>@horarios.Count(h => !h.estado)</strong>
                </div>

            </div>

            <div class="alerta-programacion">
                <i class="bi bi-info-circle-fill me-2 text-accent"></i>

                La programación semanal define los horarios recurrentes.
                Las clases con fecha específica se generarán posteriormente
                desde estos horarios.
            </div>

            <div class="info-card mb-4">

                <div class="row align-items-end g-3">

                    <div class="col-md-4">
                        <label class="info-label mb-1">
                            <i class="bi bi-funnel me-1"></i>
                            Tipo de clase
                        </label>
                        <select class="form-select" id="filtroClaseHorario">
                            <option value="">Todas las clases</option>
                            @foreach (var nombre in horarios
                                .Where(h => !string.IsNullOrWhiteSpace(h.nombreClase))
                                .Select(h => h.nombreClase)
                                .Distinct()
                                .OrderBy(n => n))
                            {
                                <option value="@nombre.ToLower()">@nombre</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="info-label mb-1">
                            <i class="bi bi-toggle-on me-1"></i>
                            Estado
                        </label>
                        <select class="form-select" id="filtroEstadoHorario">
                            <option value="">Todos</option>
                            <option value="activo">Activos</option>
                            <option value="inactivo">Inactivos</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <button type="button" class="btn-orange w-100" onclick="aplicarFiltrosHorario()">
                            <i class="bi bi-search me-2"></i>
                            Buscar
                        </button>
                    </div>

                </div>
            </div>

            <div id="contenedor-dias-paginado">

                @foreach (var dia in dias)
                {
                    <div class="dia-card" data-dia-index="@indiceDia">
                        @{ indiceDia++; }

                        <div class="dia-card-header">
                            @{
                                var fechaDia = proximaFecha(dia.Key.diaSemana);
                                var numDiaFecha = fechaDia.Day;
                                var mesNombre = mesesEs[fechaDia.Month];
                            }

                            <h2>
                                <i class="bi bi-calendar-check"></i>
                                @* Desktop: Lunes 30 de Junio *@
                                <span class="dia-header-desktop">@dia.Key.nombreDia @numDiaFecha de @mesNombre</span>
                                @* Mobile: 30 Junio *@
                                <span class="dia-header-mobile">@numDiaFecha @mesNombre</span>
                            </h2>

                            <span>
                                @dia.Count()
                                @(dia.Count() == 1 ? "horario" : "horarios")
                            </span>

                        </div>

                        <div class="table-responsive">

                            <table class="table tabla-horarios">

                                <thead>
                                    <tr>
                                        <th>Horario</th>
                                        <th>Clase</th>
                                        <th>Entrenador</th>
                                        <th class="col-mobile-oculto">Cupo</th>
                                        <th class="col-mobile-oculto">Ubicación</th>
                                        <th class="col-mobile-oculto">Estado</th>
                                        <th class="col-mobile-oculto text-end">Acciones</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (
                                        var horario in dia
                                            .OrderBy(h => h.horaInicio)
                                    )
                                    {
                                        <tr data-clase="@((horario.nombreClase ?? "").ToLower())"
                                            data-estado="@(horario.estado ? "activo" : "inactivo")">

                                            <td>
                                                <div class="horario-principal">
                                                    <i class="bi bi-clock me-1"></i>

                                                    @horario.horaInicio.ToString(@"hh\:mm")
                                                    -
                                                    @horario.horaFin.ToString(@"hh\:mm")
                                                </div>
                                            </td>

                                            <td>
                                                <div class="clase-nombre">
                                                    @horario.nombreClase
                                                </div>
                                            </td>

                                            <td>
                                                <div class="entrenador-nombre">
                                                    @horario.nombreEntrenador
                                                </div>
                                            </td>

                                            <td class="col-mobile-oculto">
                                                <strong>
                                                    @horario.cupoMaximo
                                                </strong>

                                                <span class="dato-secundario">
                                                    personas
                                                </span>
                                            </td>

                                            <td class="col-mobile-oculto">
                                                @horario.ubicacion
                                            </td>

                                            <td class="col-mobile-oculto">
                                                <span class="estado-badge
                                                @(horario.estado
                                                    ? "estado-activo"
                                                    : "estado-inactivo")">

                                                    <i class="bi
                                                    @(horario.estado
                                                        ? "bi-check-circle-fill"
                                                        : "bi-x-circle-fill")">
                                                    </i>

                                                    @horario.nombreEstado
                                                </span>
                                            </td>

                                            <td class="col-mobile-oculto">
                                                <div class="acciones-horario">

                                                    <a href="@Url.Action(
                    "Editar",
                    "HorariosSemanales",
                    new
                    {
                        id = horario.idHorario
                    }
                )"
                                                       class="btn-accion"
                                                       title="Editar horario">

                                                        <i class="bi bi-pencil-square"></i>
                                                    </a>

                                                    @using (
                                                        Html.BeginForm(
                                                            "CambiarEstado",
                                                            "HorariosSemanales",
                                                            FormMethod.Post,
                                                            new
                                                            {
                                                                @class = "form-cambiar-estado"
                                                            }
                                                        )
                                                    )
                                                    {
                                                        @Html.AntiForgeryToken()

                                                        @Html.Hidden(
                                                            "idHorario",
                                                            horario.idHorario
                                                        )

                                                        <button type="submit"
                                                                class="btn-accion estado"
                                                                title="@(horario.estado
                    ? "Desactivar horario"
                    : "Activar horario")">

                                                            <i class="bi
                    @(horario.estado
                        ? "bi-toggle-on"
                        : "bi-toggle-off")">
                                                            </i>

                                                        </button>
                                                    }

                                                </div>
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    </div>
                }

            </div>@* fin contenedor-dias-paginado *@

            <div id="paginacion-dias" class="paginacion-dias" aria-label="Paginación de días">

                <button type="button" id="btn-anterior-dia" class="btn-pag-dia" aria-label="Día anterior">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <span id="pag-indicador-dia" class="pag-indicador-dia"></span>

                <button type="button" id="btn-siguiente-dia" class="btn-pag-dia" aria-label="Día siguiente">
                    <i class="bi bi-chevron-right"></i>
                </button>

            </div>
        }
        else
        {
            <div class="estado-vacio">

                <i class="bi bi-calendar2-x"></i>

                <h3>No hay programación registrada</h3>

                <p>
                    Cree la programación semanal para definir los días,
                    horas, clases y entrenadores que se utilizarán
                    recurrentemente.
                </p>

                <a href="@Url.Action(
                        "Registrar",
                        "HorariosSemanales"
                    )"
                   class="btn btn-nueva-programacion">

                    <i class="bi bi-plus-circle me-2"></i>
                    Crear primera programación
                </a>

            </div>
        }

        @{
            var clasesUnicas = ViewBag.ClasesUnicas as
                List<GimnasioJena.Abstracciones.Modelos.Clases.ClaseListadoDto>
                ?? new List<GimnasioJena.Abstracciones.Modelos.Clases.ClaseListadoDto>();
        }

        @if (clasesUnicas.Any())
        {
            <div class="alerta-programacion mt-4">
                <i class="bi bi-info-circle-fill me-2 text-accent"></i>
                Las siguientes clases se registraron como <strong>clases únicas</strong>
                (fecha específica, no recurrentes), por lo que no forman parte de la
                programación semanal anterior. 
            </div>

            <div class="dia-card">

                <div class="dia-card-header">
                    <h2>
                        <i class="bi bi-calendar-event"></i>
                        <span>Clases únicas próximas</span>
                    </h2>

                    <span>
                        @clasesUnicas.Count
                        @(clasesUnicas.Count == 1 ? "clase" : "clases")
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table tabla-horarios">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Horario</th>
                                <th>Clase</th>
                                <th>Entrenador</th>
                                <th class="col-mobile-oculto">Cupo</th>
                                <th class="col-mobile-oculto">Estado</th>
                                <th class="col-mobile-oculto text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var clase in clasesUnicas)
                            {
                                <tr>
                                    <td>@clase.fechaClase.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @clase.horaInicio.ToString(@"hh\:mm")
                                        -
                                        @clase.horaFin.ToString(@"hh\:mm")
                                    </td>
                                    <td>@clase.nombreClase</td>
                                    <td>@clase.nombreEntrenador</td>
                                    <td class="col-mobile-oculto">@clase.cupoMaximo</td>

                                    <td class="col-mobile-oculto">
                                        <span class="estado-badge
                                            @(clase.estadoClase == "Activo"
                                                ? "estado-activo"
                                                : "estado-inactivo")">

                                            <i class="bi
                                                @(clase.estadoClase == "Activo"
                                                    ? "bi-check-circle-fill"
                                                    : "bi-x-circle-fill")">
                                            </i>

                                            @clase.estadoClase
                                        </span>
                                    </td>
                                    <td class="col-mobile-oculto text-end">
                                        <div class="acciones-horario">

                                            <a href="@Url.Action(
                    "EditarClase",
                    "Clases",
                    new
                    {
                        id = clase.idClaseProgramada
                    }
                )"
                                               class="btn-accion"
                                               title="Editar clase">

                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            @using (
                                                Html.BeginForm(
                                                    "CambiarEstado",
                                                    "Clases",
                                                    FormMethod.Post,
                                                    new
                                                    {
                                                        @class = "form-cambiar-estado"
                                                    }
                                                )
                                            )
                                            {
                                                @Html.AntiForgeryToken()

                                                @Html.Hidden(
                                                    "idClaseProgramada",
                                                    clase.idClaseProgramada
                                                )

                                                @Html.Hidden(
                                                    "returnUrl",
                                                    Url.Action("Index", "HorariosSemanales")
                                                )

                                                <button type="submit"
                                                        class="btn-accion estado"
                                                        title="@(clase.estadoClase == "Activo"
                    ? "Desactivar clase"
                    : "Activar clase")">

                                                    <i class="bi
                    @(clase.estadoClase == "Activo"
                        ? "bi-toggle-on"
                        : "bi-toggle-off")">
                                                    </i>

                                                </button>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        }

    </div>
</section>

@section Scripts {
    <script>
        (function () {

            var CARDS_DESKTOP = 7;
            var CARDS_MOBILE  = 1;
            var BREAKPOINT    = 768;

            var contenedor   = document.getElementById('contenedor-dias-paginado');
            var paginacion   = document.getElementById('paginacion-dias');
            var btnAnterior  = document.getElementById('btn-anterior-dia');
            var btnSiguiente = document.getElementById('btn-siguiente-dia');
            var indicador    = document.getElementById('pag-indicador-dia');

            if (!contenedor) { return; }

            var todasLasCards = Array.prototype.slice.call(
                contenedor.querySelectorAll('.dia-card')
            );

            var paginaActual = 0;

            /* ---- FILTRADO ---- */
            function aplicarFiltrosHorario() {

                var filtroClase  = document.getElementById('filtroClaseHorario').value.toLowerCase();
                var filtroEstado = document.getElementById('filtroEstadoHorario').value.toLowerCase();

                todasLasCards.forEach(function (card) {

                    var filas = Array.prototype.slice.call(
                        card.querySelectorAll('tbody tr')
                    );

                    var hayFilasVisibles = false;

                    filas.forEach(function (fila) {
                        var clase  = (fila.getAttribute('data-clase')  || '').toLowerCase();
                        var estado = (fila.getAttribute('data-estado') || '').toLowerCase();

                        var coincide =
                            (!filtroClase  || clase  === filtroClase)  &&
                            (!filtroEstado || estado === filtroEstado);

                        fila.style.display = coincide ? '' : 'none';

                        if (coincide) { hayFilasVisibles = true; }
                    });

                    // Marcar card como filtrada (no eliminarla, solo marcarla)
                    card.setAttribute('data-filtrado', hayFilasVisibles ? 'visible' : 'oculto');
                });

                paginaActual = 0;
                mostrar();
            }

            window.aplicarFiltrosHorario = aplicarFiltrosHorario;

            /* ---- PAGINACIÓN ---- */
            function cardsVisibles() {
                return todasLasCards.filter(function (c) {
                    return c.getAttribute('data-filtrado') !== 'oculto';
                });
            }

            function porPagina() {
                return window.innerWidth >= BREAKPOINT ? CARDS_DESKTOP : CARDS_MOBILE;
            }

            function totalPaginas() {
                return Math.max(1, Math.ceil(cardsVisibles().length / porPagina()));
            }

            function mostrar() {
                var visibles = cardsVisibles();
                var pp       = porPagina();
                var total    = totalPaginas();

                if (paginaActual >= total) { paginaActual = total - 1; }
                if (paginaActual < 0)      { paginaActual = 0; }

                var inicio = paginaActual * pp;
                var fin    = inicio + pp;

                // Ocultar todas primero
                todasLasCards.forEach(function (card) {
                    card.style.display = 'none';
                });

                // Mostrar solo las de la página actual dentro de las visibles
                visibles.forEach(function (card, idx) {
                    card.style.display = (idx >= inicio && idx < fin) ? '' : 'none';
                });

                if (total > 1) {
                    paginacion.style.display = '';
                    indicador.textContent    = (paginaActual + 1) + ' / ' + total;
                    btnAnterior.disabled     = paginaActual === 0;
                    btnSiguiente.disabled    = paginaActual === total - 1;
                } else {
                    paginacion.style.display = 'none';
                }
            }

            btnAnterior.addEventListener('click', function () {
                if (paginaActual > 0) { paginaActual--; mostrar(); }
            });

            btnSiguiente.addEventListener('click', function () {
                if (paginaActual < totalPaginas() - 1) { paginaActual++; mostrar(); }
            });

            window.addEventListener('resize', function () { mostrar(); });

            // Inicializar: marcar todas como visibles
            todasLasCards.forEach(function (c) {
                c.setAttribute('data-filtrado', 'visible');
            });

            mostrar();
        })();
    </script>
}