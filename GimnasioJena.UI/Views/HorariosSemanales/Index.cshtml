@model IEnumerable<GimnasioJena.Abstracciones.Modelos.HorariosSemanales.HorarioSemanalListadoDto>

@{
    ViewBag.Title = "Programación semanal";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var horarios = Model != null
        ? Model.ToList()
        : new List<GimnasioJena.Abstracciones.Modelos.HorariosSemanales.HorarioSemanalListadoDto>();

    var dias = horarios
        .GroupBy(h => new
        {
            h.diaSemana,
            h.nombreDia
        })
        .OrderBy(g => g.Key.diaSemana)
        .ToList();
}

<section class="horarios-page">
    <div class="container">

        <div class="horarios-header">

            <div class="horarios-title-area">

                <div class="horarios-icon">
                    <i class="bi bi-calendar-week"></i>
                </div>

                <div class="horarios-title">
                    <h1 class="page-title">Programación semanal</h1>

                    <p>
                        Administre los horarios recurrentes utilizados
                        para generar las clases del gimnasio.
                    </p>
                </div>

            </div>

            <div class="horarios-actions">

                <a href="@Url.Action(
                        "Registrar",
                        "HorariosSemanales"
                    )"
                   class="btn btn-nueva-programacion">

                    <i class="bi bi-plus-circle me-2"></i>
                    Nueva programación
                </a>

                <a href="@Url.Action(
                        "GenerarClases",
                        "HorariosSemanales"
                    )"
                   class="btn btn-generar">

                    <i class="bi bi-calendar-plus me-2"></i>
                    Generar próximas clases
                </a>

            </div>
        </div>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["MensajeExito"]
            </div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["MensajeError"]
            </div>
        }

        @if (horarios.Any())
        {
            <div class="resumen-programacion">

                <div class="resumen-card">
                    <span>Total de horarios</span>
                    <strong>@horarios.Count</strong>
                </div>

                <div class="resumen-card activos">
                    <span>Horarios activos</span>
                    <strong>@horarios.Count(h => h.estado)</strong>
                </div>

                <div class="resumen-card inactivos">
                    <span>Horarios inactivos</span>
                    <strong>@horarios.Count(h => !h.estado)</strong>
                </div>

            </div>

            <div class="alerta-programacion">
                <i class="bi bi-info-circle-fill me-2 text-accent"></i>

                La programación semanal define los horarios recurrentes.
                Las clases con fecha específica se generarán posteriormente
                desde estos horarios.
            </div>

            foreach (var dia in dias)
            {
                <div class="dia-card">

                    <div class="dia-card-header">

                        <h2>
                            <i class="bi bi-calendar-day me-2"></i>
                            @dia.Key.nombreDia
                        </h2>

                        <span>
                            @dia.Count()
                            @(dia.Count() == 1 ? "horario" : "horarios")
                        </span>

                    </div>

                    <div class="table-responsive">

                        <table class="table tabla-horarios">

                            <thead>
                                <tr>
                                    <th>Horario</th>
                                    <th>Clase</th>
                                    <th>Entrenador</th>
                                    <th>Cupo</th>
                                    <th>Ubicación</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (
                                    var horario in dia
                                        .OrderBy(h => h.horaInicio)
                                )
                                {
                                    <tr>

                                        <td>
                                            <div class="horario-principal">
                                                <i class="bi bi-clock me-1"></i>

                                                @horario.horaInicio.ToString(@"hh\:mm")
                                                -
                                                @horario.horaFin.ToString(@"hh\:mm")
                                            </div>

                                            <div class="dato-secundario">
                                                ID: @horario.idHorario
                                            </div>
                                        </td>

                                        <td>
                                            <div class="clase-nombre">
                                                @horario.nombreClase
                                            </div>
                                        </td>

                                        <td>
                                            <div class="entrenador-nombre">
                                                @horario.nombreEntrenador
                                            </div>
                                        </td>

                                        <td>
                                            <strong>
                                                @horario.cupoMaximo
                                            </strong>

                                            <span class="dato-secundario">
                                                personas
                                            </span>
                                        </td>

                                        <td>
                                            @horario.ubicacion
                                        </td>

                                        <td>
                                            <span class="estado-badge
                                                @(horario.estado
                                                    ? "estado-activo"
                                                    : "estado-inactivo")">

                                                <i class="bi
                                                    @(horario.estado
                                                        ? "bi-check-circle-fill"
                                                        : "bi-x-circle-fill")">
                                                </i>

                                                @horario.nombreEstado
                                            </span>
                                        </td>

                                        <td>
                                            <div class="acciones-horario">

                                                <a href="@Url.Action(
                    "Editar",
                    "HorariosSemanales",
                    new
                    {
                        id = horario.idHorario
                    }
                )"
                                                   class="btn-accion"
                                                   title="Editar horario">

                                                    <i class="bi bi-pencil-square"></i>
                                                </a>

                                                @using (
                                                    Html.BeginForm(
                                                        "CambiarEstado",
                                                        "HorariosSemanales",
                                                        FormMethod.Post,
                                                        new
                                                        {
                                                            @class = "form-cambiar-estado"
                                                        }
                                                    )
                                                )
                                                {
                                                    @Html.AntiForgeryToken()

                                                    @Html.Hidden(
                                                        "idHorario",
                                                        horario.idHorario
                                                    )

                                                    <button type="submit"
                                                            class="btn-accion estado"
                                                            title="@(horario.estado
                    ? "Desactivar horario"
                    : "Activar horario")">

                                                        <i class="bi
                    @(horario.estado
                        ? "bi-toggle-on"
                        : "bi-toggle-off")">
                                                        </i>

                                                    </button>
                                                }

                                            </div>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="estado-vacio">

                <i class="bi bi-calendar2-x"></i>

                <h3>No hay programación registrada</h3>

                <p>
                    Cree la programación semanal para definir los días,
                    horas, clases y entrenadores que se utilizarán
                    recurrentemente.
                </p>

                <a href="@Url.Action(
                        "Registrar",
                        "HorariosSemanales"
                    )"
                   class="btn btn-nueva-programacion">

                    <i class="bi bi-plus-circle me-2"></i>
                    Crear primera programación
                </a>

            </div>
        }

    </div>
</section>