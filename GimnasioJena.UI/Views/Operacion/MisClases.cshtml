@{
    ViewBag.Title = "MisClases";
}

<div class="container-fluid p-4">
    <!-- Sección de Bienvenida con Logo -->
    <div class="welcome-section">
        <div class="logo-circular">
            <i class="bi bi-tree"></i>
            <span class="letter-j">J</span>
        </div>
        <div class="welcome-text">
            <p class="welcome-subtitle">Mis Clases Programadas</p>
            <p>Gestiona y visualiza todas tus clases inscritas</p>
        </div>
    </div>

    <!-- Título Principal -->
    <div class="text-center mb-5">
        <h1 class="page-title">Mis Clases</h1>
    </div>

    <!-- Estadísticas Rápidas -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="stats-card">
                <i class="bi bi-calendar-check"></i>
                <span class="stat-number">3</span>
                <p>Clases Activas</p>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="stats-card">
                <i class="bi bi-clock-history"></i>
                <span class="stat-number">12</span>
                <p>Horas Totales</p>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="stats-card">
                <i class="bi bi-trophy"></i>
                <span class="stat-number">85%</span>
                <p>Asistencia</p>
            </div>
        </div>
    </div>

    <!-- Grid de Clases -->
    <div class="row justify-content-center">
        <!-- Clase 1: Spinning -->
        <div class="col-md-4 mb-4">
            <div class="card-clase">
                <div class="card-image-placeholder spinning">
                    <i class="bi bi-bicycle"></i>
                </div>
                <div class="card-body">
                    <span class="status-badge active">En curso</span>
                    <h2>Clases de Spinning</h2>

                    <div class="info-item">
                        <i class="bi bi-person-badge"></i>
                        <span><strong>Profesor:</strong> Diego Pérez</span>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-clock"></i>
                        <span><strong>Hora:</strong> 10:00 AM</span>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-calendar-event"></i>
                        <span><strong>Fecha:</strong> 30/05/2026</span>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-geo-alt"></i>
                        <span><strong>Sala:</strong> Studio A</span>
                    </div>

                    <button class="btn btn-action mt-3">
                        <i class="bi bi-eye me-2"></i>Ver detalles
                    </button>
                </div>
            </div>
        </div>

        <!-- Clase 2: Yoga -->
        <div class="col-md-4 mb-4">
            <div class="card-clase">
                <div class="card-image-placeholder yoga">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div class="card-body">
                    <span class="status-badge upcoming">Próxima</span>
                    <h2>Clases de Yoga</h2>

                    <div class="info-item">
                        <i class="bi bi-person-badge"></i>
                        <span><strong>Profesor:</strong> María Gómez</span>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-clock"></i>
                        <span><strong>Hora:</strong> 5:00 PM</span>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-calendar-event"></i>
                        <span><strong>Fecha:</strong> 29/05/2026</span>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-geo-alt"></i>
                        <span><strong>Sala:</strong> Studio Zen</span>
                    </div>

                    <button class="btn btn-action mt-3">
                        <i class="bi bi-eye me-2"></i>Ver detalles
                    </button>
                </div>
            </div>
        </div>

        <!-- Clase 3: Boxeo -->
        <div class="col-md-4 mb-4">
            <div class="card-clase">
                <div class="card-image-placeholder boxeo">
                    <i class="bi bi-trophy"></i>
                </div>
                <div class="card-body">
                    <span class="status-badge upcoming">Próxima</span>
                    <h2>Clases de Boxeo</h2>

                    <div class="info-item">
                        <i class="bi bi-person-badge"></i>
                        <span><strong>Profesor:</strong> Carlos Ramírez</span>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-clock"></i>
                        <span><strong>Hora:</strong> 7:00 PM</span>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-calendar-event"></i>
                        <span><strong>Fecha:</strong> 28/05/2026</span>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-geo-alt"></i>
                        <span><strong>Sala:</strong> Ring Principal</span>
                    </div>

                    <button class="btn btn-action mt-3">
                        <i class="bi bi-eye me-2"></i>Ver detalles
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>