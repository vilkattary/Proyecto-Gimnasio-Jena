@model IEnumerable<GimnasioJena.Abstracciones.Modelos.Entrenadores.EntrenadorListadoDto>

@{
    ViewBag.Title = "Administrar entrenadores";
}

<link href="@(Url.Content("~/Content/estilo/estilo.css"))" rel="stylesheet" />

<section class="container py-5">
    <h2 class="text-navy">
        Administrar entrenadores
    </h2>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    <div class="card-jena-info">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table-jena">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Especialidad</th>
                            <th>Fecha contratación</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="cuerpoTablaEntrenadores">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.nombreCompleto</td>
                                    <td>@item.correo</td>
                                    <td>@item.especialidad</td>
                                    <td>@item.fechaContratacion.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (item.estado)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Editar", "Entrenadores", new { id = item.idEntrenador })"
                                           class="btn btn-sm btn-action">
                                            Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    No hay entrenadores registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="paginacion-info" id="paginacionInfoEntrenadores"></p>
            <div id="paginacion-mobile-entrenadores" class="paginacion-mobile-wrapper"></div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    /* ── Paginación mobile – Entrenadores ───────────────────── */
    (function () {
        var POR_PAGINA = 5;
        var paginaActual = 1;

        function esMobile() { return window.innerWidth < 768; }

        function filas() {
            return Array.from(document.querySelectorAll('#cuerpoTablaEntrenadores tr'));
        }

        function renderPaginacion(totalPaginas) {
            var container = document.getElementById('paginacion-mobile-entrenadores');
            var info      = document.getElementById('paginacionInfoEntrenadores');
            if (!container) return;

            if (!esMobile() || totalPaginas <= 1) {
                container.style.display = 'none';
                if (info) info.style.display = 'none';
                return;
            }

            if (info) {
                var desde = (paginaActual - 1) * POR_PAGINA + 1;
                var hasta = Math.min(paginaActual * POR_PAGINA, filas().length);
                info.textContent = 'Mostrando ' + desde + '–' + hasta + ' de ' + filas().length + ' entrenadores';
                info.style.display = 'block';
            }

            var html = '<ul class="pagination-jena">';

            html += '<li class="page-jena-item' + (paginaActual === 1 ? ' disabled' : '') + '">'
                  + '<button class="page-jena-btn" data-p="' + (paginaActual - 1) + '" aria-label="Anterior">'
                  + '<i class="bi bi-chevron-left"></i></button></li>';

            for (var i = 1; i <= totalPaginas; i++) {
                html += '<li class="page-jena-item' + (i === paginaActual ? ' active' : '') + '">'
                      + '<button class="page-jena-btn" data-p="' + i + '">' + i + '</button></li>';
            }

            html += '<li class="page-jena-item' + (paginaActual === totalPaginas ? ' disabled' : '') + '">'
                  + '<button class="page-jena-btn" data-p="' + (paginaActual + 1) + '" aria-label="Siguiente">'
                  + '<i class="bi bi-chevron-right"></i></button></li>';

            html += '</ul>';
            container.innerHTML = html;
            container.style.display = 'flex';

            container.querySelectorAll('.page-jena-btn[data-p]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    irAPagina(parseInt(this.getAttribute('data-p')));
                });
            });
        }

        function irAPagina(p) {
            var total = Math.ceil(filas().length / POR_PAGINA);
            if (p < 1 || p > total) return;
            paginaActual = p;
            aplicar();
        }

        function aplicar() {
            var rows  = filas();
            var total = Math.ceil(rows.length / POR_PAGINA);

            if (!esMobile()) {
                rows.forEach(function (r) { r.style.display = ''; });
                var c = document.getElementById('paginacion-mobile-entrenadores');
                var i = document.getElementById('paginacionInfoEntrenadores');
                if (c) c.style.display = 'none';
                if (i) i.style.display = 'none';
                return;
            }

            var desde = (paginaActual - 1) * POR_PAGINA;
            var hasta = desde + POR_PAGINA;
            rows.forEach(function (r, idx) {
                r.style.display = (idx >= desde && idx < hasta) ? '' : 'none';
            });
            renderPaginacion(total);
        }

        aplicar();

        var resizeTimer;
        window.addEventListener('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                paginaActual = 1;
                aplicar();
            }, 150);
        });
    }());
</script>
}