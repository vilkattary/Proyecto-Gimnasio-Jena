@model IEnumerable<GimnasioJena.Abstracciones.Modelos.Clases.ClaseEntrenadorDto>

@{
    ViewBag.Title = "Mis Clases";
}

<link href="@(Url.Content("~/Content/estilo/estilo.css"))" rel="stylesheet" />

<section class="container py-5 mis-clases-entrenador">

    <a href="javascript:history.back()" class="btn btn-volver" aria-label="Volver">
        <i class="bi bi-arrow-left"></i> Atrás
    </a>
    <h2 class="text-navy">
        Mis clases asignadas
    </h2>

    <div class="card-jena-info">
        <div class="card-body p-4">
            <div class="card-jena-info mb-4">
                <div class="card-body p-3">

                    <div class="row g-3">

                        <div class="col-12 col-md-4">
                            <label for="filtroPeriodo" class="form-label">
                                <i class="bi bi-calendar3 me-1"></i> Período
                            </label>
                            <select id="filtroPeriodo" class="form-select">
                                <option value="todas">Todas las clases</option>
                                <option value="proximas">Próximas clases</option>
                                <option value="pasadas">Clases pasadas</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label for="filtroEstado" class="form-label">
                                <i class="bi bi-toggle-on me-1"></i> Estado
                            </label>
                            <select id="filtroEstado" class="form-select">
                                <option value="todos">Todos los estados</option>
                                <option value="1">Activas</option>
                                <option value="2">Canceladas</option>
                                <option value="3">Finalizadas</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label for="filtroFecha" class="form-label">
                                <i class="bi bi-calendar-date me-1"></i> Fecha
                            </label>
                            <input type="date"
                                   id="filtroFecha"
                                   class="form-control" />
                        </div>

                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <button type="button"
                                id="btnBuscarClases"
                                class="btn btn-action">
                            <i class="bi bi-search me-1"></i> Buscar
                        </button>

                        <button type="button"
                                id="btnLimpiarClases"
                                class="btn btn-outline-gym">
                            <i class="bi bi-x-circle me-1"></i> Limpiar
                        </button>
                    </div>

                </div>
            </div>
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info mb-0">
                    Aún no tienes clases asignadas.
                </div>
            }
            else
            {

                <div class="table-responsive">
                    <table class="table-jena">
                        <thead>
                            <tr>
                                <th>Clase</th>
                                <th>Fecha</th>
                                <th>Horario</th>
                                <th>Cupo</th>
                                <th>Inscritos</th>
                                <th>Ubicación</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="fila-clase"
                                    data-fecha="@item.fechaClase.ToString("yyyy-MM-dd")"
                                    data-estado="@item.idEstadoClase">
                                    <td data-label="Clase">@item.nombreClase</td>

                                    <td data-label="Fecha">
                                        @item.fechaClase.ToString("dd/MM/yyyy")
                                    </td>

                                    <td data-label="Horario">
                                        @item.horaInicio.ToString(@"hh\:mm") - @item.horaFin.ToString(@"hh\:mm")
                                    </td>

                                    <td data-label="Cupo">
                                        @item.cupoMaximo
                                    </td>

                                    <td data-label="Inscritos">
                                        @item.inscritos
                                    </td>

                                    <td data-label="Ubicación">
                                        @item.ubicacion
                                    </td>

                                    <td data-label="Estado" class="text-center align-middle">
                                        @switch (item.idEstadoClase)
                                        {
                                            case 1:
                                                <span class="badge bg-success">Activa</span>
                                                break;
                                            case 2:
                                                <span class="badge bg-danger">Cancelada</span>
                                                break;
                                            case 3:
                                                <span class="badge bg-secondary">Finalizada</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@item.nombreEstado</span>
                                                break;
                                        }
                                    </td>

                                    <td data-label="Acciones" class="text-center align-middle">
                                        @if (item.idEstadoClase == 1)
                                        {
                                            <a href="@Url.Action("AsistenciaClase", "Entrenadores", new { id = item.idClaseProgramada })"
                                               class="btn btn-sm btn-action">
                                                Registrar asistencia
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No disponible</span>
                                        }
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="infoPaginacionClases"
                     class="paginacion-info mt-3">
                </div>

                <nav id="paginacionClases"
                     class="d-flex justify-content-center mt-3"
                     aria-label="Paginación de mis clases">
                </nav>

                <div id="mensajeSinResultados"
                     class="alert alert-info mt-3"
                     style="display:none;">
                    No se encontraron clases con los filtros seleccionados.
                </div>

            }

        </div>
    </div>
</section>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const filtroPeriodo = document.getElementById('filtroPeriodo');
            const filtroEstado = document.getElementById('filtroEstado');
            const filtroFecha = document.getElementById('filtroFecha');

            const filas = Array.from(
                document.querySelectorAll('.fila-clase')
            );

            const contenedorPaginacion =
                document.getElementById('paginacionClases');

            const infoPaginacion =
                document.getElementById('infoPaginacionClases');

            const mensajeSinResultados =
                document.getElementById('mensajeSinResultados');

            if (!filtroPeriodo || !filtroEstado || !filtroFecha) return;

            function obtenerCantidadPorPagina() {
                return window.innerWidth < 768 ? 3 : 15;
            }
            let paginaActual = 1;
            let filasFiltradas = [];

            function aplicarFiltros() {

                const periodo = filtroPeriodo.value;
                const estado = filtroEstado.value;
                const fechaSeleccionada = filtroFecha.value;

                const hoy = new Date();
                hoy.setHours(0, 0, 0, 0);

                filasFiltradas = filas.filter(function (fila) {

                    const fechaFila = fila.getAttribute('data-fecha');
                    const estadoClase = fila.getAttribute('data-estado');

                    const fechaClase = new Date(
                        fechaFila + 'T00:00:00'
                    );

                    let cumplePeriodo = true;
                    let cumpleEstado = true;
                    let cumpleFecha = true;

                    if (periodo === 'proximas') {
                        cumplePeriodo = fechaClase >= hoy;
                    }
                    else if (periodo === 'pasadas') {
                        cumplePeriodo = fechaClase < hoy;
                    }

                    if (estado !== 'todos') {
                        cumpleEstado = estadoClase === estado;
                    }

                    if (fechaSeleccionada !== '') {
                        cumpleFecha = fechaFila === fechaSeleccionada;
                    }

                    return cumplePeriodo && cumpleEstado && cumpleFecha;
                });

                paginaActual = 1;
                mostrarPagina();
            }

            function mostrarPagina() {

                const POR_PAGINA = obtenerCantidadPorPagina();

                const totalRegistros = filasFiltradas.length;
                const totalPaginas = Math.ceil(totalRegistros / POR_PAGINA);

                const inicio = (paginaActual - 1) * POR_PAGINA;
                const fin = inicio + POR_PAGINA;

                // Ocultar todas las filas antes de mostrar la página.
                filas.forEach(function (fila) {
                    fila.style.display = 'none';
                });

             // Mostrar únicamente las filas correspondientes a la página actual.
                filasFiltradas.slice(inicio, fin).forEach(function (fila) {
                    fila.style.display = '';
                });

                // Mensaje cuando no hay coincidencias.
                if (mensajeSinResultados) {
                    mensajeSinResultados.style.display =
                        totalRegistros === 0 ? 'block' : 'none';
                }

                // Información de registros visibles.
                if (infoPaginacion) {
                    if (totalRegistros === 0) {
                        infoPaginacion.textContent = '';
                    }
                    else {
                        const desde = inicio + 1;
                        const hasta = Math.min(fin, totalRegistros);

                        infoPaginacion.textContent =
                            'Mostrando ' + desde + '–' + hasta +
                            ' de ' + totalRegistros + ' clases';
                    }
                }

                renderizarPaginacion(totalPaginas);
            }

            function renderizarPaginacion(totalPaginas) {

                if (!contenedorPaginacion) return;

                contenedorPaginacion.innerHTML = '';

                if (totalPaginas <= 1) return;

                const lista = document.createElement('ul');
                lista.className = 'pagination-jena';

                function agregarBoton(texto, pagina, activo, deshabilitado) {

                    const elemento = document.createElement('li');

                    elemento.className = 'page-jena-item' +
                        (activo ? ' active' : '') +
                        (deshabilitado ? ' disabled' : '');

                    const boton = document.createElement('button');
                    boton.type = 'button';
                    boton.className = 'page-jena-btn';
                    boton.textContent = texto;
                    boton.disabled = deshabilitado;

                    boton.addEventListener('click', function () {
                        paginaActual = pagina;
                        mostrarPagina();
                    });

                    elemento.appendChild(boton);
                    lista.appendChild(elemento);
                }

                agregarBoton(
                    '‹',
                    paginaActual - 1,
                    false,
                    paginaActual === 1
                );

                for (let pagina = 1; pagina <= totalPaginas; pagina++) {
                    agregarBoton(
                        pagina.toString(),
                        pagina,
                        pagina === paginaActual,
                        false
                    );
                }

                agregarBoton(
                    '›',
                    paginaActual + 1,
                    false,
                    paginaActual === totalPaginas
                );

                contenedorPaginacion.appendChild(lista);
            }

            const btnBuscar = document.getElementById('btnBuscarClases');
            const btnLimpiar = document.getElementById('btnLimpiarClases');

            btnBuscar.addEventListener('click', aplicarFiltros);

            btnLimpiar.addEventListener('click', function () {

                filtroPeriodo.value = 'todas';
                filtroEstado.value = 'todos';
                filtroFecha.value = '';

                aplicarFiltros();
            });

            aplicarFiltros();
            let modoMovilAnterior = window.innerWidth < 768;

            window.addEventListener('resize', function () {
                const modoMovilActual = window.innerWidth < 768;

                if (modoMovilActual !== modoMovilAnterior) {
                    modoMovilAnterior = modoMovilActual;
                    paginaActual = 1;
                    mostrarPagina();
                }
            });
        });
    </script>
}