@model IEnumerable<GimnasioJena.Abstracciones.Modelos.Clases.ClaseEntrenadorDto>

@{
    ViewBag.Title = "Mis Clases";
}

<link href="@(Url.Content("~/Content/estilo/estilo.css"))" rel="stylesheet" />

<section class="container py-5">

    <a href="javascript:history.back()" class="btn btn-volver" aria-label="Volver">
        <i class="bi bi-arrow-left"></i> Atrás
    </a>
    <h2 class="text-navy">
        Mis clases asignadas
    </h2>

    <div class="card-jena-info">


        <div class="card-body p-4">

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info mb-0">
                    Aún no tienes clases asignadas.
                </div>
            }
            else
            {

                <div class="table-responsive">
                    <table class="table-jena">
                        <thead>
                            <tr>
                                <th>Clase</th>
                                <th>Fecha</th>
                                <th>Horario</th>
                                <th>Cupo</th>
                                <th>Inscritos</th>
                                <th>Ubicación</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.nombreClase</td>
                                    <td>@item.fechaClase.ToString("dd/MM/yyyy")</td>
                                    <td>@item.horaInicio.ToString(@"hh\:mm") - @item.horaFin.ToString(@"hh\:mm")</td>
                                    <td>@item.cupoMaximo</td>
                                    <td>@item.inscritos</td>

                                    <td>@item.ubicacion</td>

                                    <td class="text-center align-middle">
                                        @switch (item.idEstadoClase)
                                        {
                                            case 1:
                                                <span class="badge bg-success">Activa</span>
                                                break;
                                            case 2:
                                                <span class="badge bg-danger">Cancelada</span>
                                                break;
                                            case 3:
                                                <span class="badge bg-secondary">Finalizada</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@item.nombreEstado</span>
                                                break;
                                        }
                                    </td>

                                    <td class="text-center align-middle">
                                        @if (item.idEstadoClase == 1)
                                        {
                                            <a href="@Url.Action("AsistenciaClase", "Entrenadores", new { id = item.idClaseProgramada })"
                                               class="btn btn-sm btn-action">
                                                Registrar asistencia
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No disponible</span>
                                        }
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            }

        </div>
    </div>
</section>

