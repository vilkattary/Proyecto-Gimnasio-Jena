@model IEnumerable<GimnasioJena.Abstracciones.Modelos.Usuarios.UsuarioListadoDto>

@{
    ViewBag.Title = "Gestión de usuarios";
    var entrenadores = ViewBag.Entrenadores as List<GimnasioJena.Abstracciones.Modelos.Entrenadores.EntrenadorListadoDto>
                       ?? new List<GimnasioJena.Abstracciones.Modelos.Entrenadores.EntrenadorListadoDto>();
}

<div class="container py-5">
    <div class="mb-5">
        <h1 class="page-title">Gestión de usuarios</h1>
        <p class="text-muted">Administre los usuarios registrados, sus roles y el acceso al sistema.</p>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success" id="alertaExito">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger" id="alertaError">
            @TempData["MensajeError"]
        </div>
    }

    <div class="info-card info-card-tabla">
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                No hay usuarios registrados.
            </div>
        }
        else
        {
            <!-- FILTROS -->
            <div class="row g-2 mb-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Rol</label>
                    <select id="filterRol" class="form-select">
                        <option value="">Todos</option>
                        @{
                            var roles = Model.Select(x => x.rol ?? "").Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s);
                            foreach (var rolItem in roles)
                            {
                                <option value="@rolItem">@rolItem</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select id="filterEstado" class="form-select">
                        <option value="">Todos</option>
                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha registro (desde / hasta)</label>

                    <!-- Fechas -->
                    <div class="d-flex gap-2 mb-2">
                        <input id="filterFechaDesde" type="date" class="form-control" />
                        <input id="filterFechaHasta" type="date" class="form-control" />
                    </div>
                </div>
                <!-- Botones -->
                <div class="d-flex justify-content-end gap-2 mt-2">
                    <button id="btnFilterApply" class="btn-orange w-100">
                        Aplicar
                    </button>
                    <button id="btnFilterReset" class="btn-orange w-100">
                        Limpiar
                    </button>
                </div>
            </div>

            <div class="table-jena-wrapper">
                <table class="table-jena">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Identificación</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Rol actual</th>
                            <th>Estado</th>
                            <th>Fecha registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="cuerpoTabla">
                        @foreach (var usuario in Model)
                        {
                            var entrenador = entrenadores.FirstOrDefault(e => e.idUsuario == usuario.idUsuario);

                            string badgeRol;
                            if (usuario.rol == "ADMINISTRADOR") { badgeRol = "badge-jena-admin"; }
                            else if (usuario.rol == "ENTRENADOR") { badgeRol = "badge-jena-coach"; }
                            else { badgeRol = "badge-jena-client"; }

                            <tr data-rol="@(usuario.rol ?? "")" data-estado="@(usuario.estado ? "Activo" : "Inactivo")" data-fecha="@usuario.fechaRegistro.ToString("yyyy-MM-dd")" data-filtered="false">
                                <td data-label="Nombre">@usuario.nombreCompleto</td>
                                <td data-label="Identificación">@usuario.identificacion</td>
                                <td data-label="Correo">@usuario.correo</td>
                                <td data-label="Teléfono">@usuario.telefono</td>
                                <td data-label="Rol actual">
                                    <span class="@badgeRol">@usuario.rol</span>
                                </td>
                                <td data-label="Estado">
                                    @if (usuario.estado)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td data-label="Fecha registro">@usuario.fechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td class="td-acciones">
                                    <div class="d-flex flex-column align-items-center gap-2">

                                        <button type="button"
                                                class="btn btn-jena-outline"
                                                onclick="cargarVistaModalRol('@usuario.identityUserId')">
                                            <i class="bi bi-shield-check me-1"></i>
                                            Cambiar rol
                                        </button>

                                        @if (entrenador != null)
                                        {
                                            <button type="button"
                                                    class="btn btn-jena-outline"
                                                    onclick="cargarVistaModalEntrenador(@entrenador.idEntrenador)">
                                                <i class="bi bi-person-badge me-1"></i>
                                                Editar entrenador
                                            </button>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="paginacion-info" id="paginacionInfo"></p>
            <div id="paginacion-mobile" class="paginacion-mobile-wrapper"></div>
        }
    </div>
</div>

<!-- Modal: Cambiar Rol -->
<div class="modal fade" id="modalDinamicoRol" tabindex="-1" aria-labelledby="modalRolLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalRolLabel">Cambiar rol de usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalDinamicoRolBody">
            </div>
        </div>
    </div>
</div>

<!-- Modal: Editar Entrenador -->
<div class="modal fade" id="modalDinamicoEntrenador" tabindex="-1" aria-labelledby="modalEntrenadorLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEntrenadorLabel">Editar información del entrenador</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalDinamicoEntrenadorBody">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    function cargarVistaModalRol(identityUserId) {
        var url = '@Url.Action("CambiarRol", "Usuarios")?identityUserId=' + encodeURIComponent(identityUserId);
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); })
            .then(function (html) {
                document.getElementById('modalDinamicoRolBody').innerHTML = html;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalDinamicoRol')).show();
                interceptarFormModal('modalDinamicoRol');
            })
            .catch(function () { alert('Error al cargar el formulario.'); });
    }

    function cargarVistaModalEntrenador(idEntrenador) {
        var url = '@Url.Action("Editar", "Entrenadores")/' + idEntrenador;
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); })
            .then(function (html) {
                document.getElementById('modalDinamicoEntrenadorBody').innerHTML = html;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalDinamicoEntrenador')).show();
                interceptarFormModal('modalDinamicoEntrenador');
            })
            .catch(function () { alert('Error al cargar el formulario.'); });
    }

    function interceptarFormModal(modalId) {
        var modalEl = document.getElementById(modalId);
        var form = modalEl.querySelector('form');
        if (!form) return;

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var formData = new FormData(form);
            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function (r) {
                if (r.ok) {
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                    window.location.reload();
                } else {
                    return r.text().then(function (html) {
                        modalEl.querySelector('.modal-body').innerHTML = html;
                        interceptarFormModal(modalId);
                    });
                }
            })
            .catch(function () { alert('Error al guardar los cambios.'); });
        });
    }

    /* ── Paginación + Filtros – Usuarios ─────────────────────────────────── */
    (function () {
        var REGISTROS_MOBILE = 2;
        var REGISTROS_DESKTOP = 15;
        var paginaActual = 1;

        function esMobile() { return window.innerWidth < 768; }

        function obtenerRegistrosPorPagina() {
            return esMobile() ? REGISTROS_MOBILE : REGISTROS_DESKTOP;
        }

        // filas consideradas por paginación: solo aquellas que no están filtradas
        function filas() {
            return Array.from(document.querySelectorAll('#cuerpoTabla tr')).filter(function (r) {
                return r.dataset.filtered !== 'true';
            });
        }

        function renderPaginacion(totalPaginas) {
            var container = document.getElementById('paginacion-mobile');
            var info      = document.getElementById('paginacionInfo');
            if (!container) return;

            if (totalPaginas <= 1) {
                container.style.display = 'none';
                if (info) info.style.display = 'none';
                return;
            }

            if (info) {
                var porPagina = obtenerRegistrosPorPagina();
                var desde = (paginaActual - 1) * porPagina + 1;
                var hasta = Math.min(paginaActual * porPagina, filas().length);
                info.textContent = 'Mostrando ' + desde + '–' + hasta + ' de ' + filas().length + ' usuarios';
                info.style.display = 'block';
            }

            var html = '<ul class="pagination-jena">';

            html += '<li class="page-jena-item' + (paginaActual === 1 ? ' disabled' : '') + '">'
                  + '<button class="page-jena-btn" data-p="' + (paginaActual - 1) + '" aria-label="Anterior">'
                  + '<i class="bi bi-chevron-left"></i></button></li>';

            for (var i = 1; i <= totalPaginas; i++) {
                html += '<li class="page-jena-item' + (i === paginaActual ? ' active' : '') + '">'
                      + '<button class="page-jena-btn" data-p="' + i + '">' + i + '</button></li>';
            }

            html += '<li class="page-jena-item' + (paginaActual === totalPaginas ? ' disabled' : '') + '">'
                  + '<button class="page-jena-btn" data-p="' + (paginaActual + 1) + '" aria-label="Siguiente">'
                  + '<i class="bi bi-chevron-right"></i></button></li>';

            html += '</ul>';
            container.innerHTML = html;
            container.style.display = 'flex';

            container.querySelectorAll('.page-jena-btn[data-p]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    irAPagina(parseInt(this.getAttribute('data-p')));
                });
            });
        }

        function irAPagina(p) {
            var total = Math.ceil(filas().length / obtenerRegistrosPorPagina()) || 1;
            if (p < 1 || p > total) return;
            paginaActual = p;
            aplicar();
        }

        function aplicar() {
            var allRows = Array.from(document.querySelectorAll('#cuerpoTabla tr'));
            var visibleRows = filas();
            var porPagina = obtenerRegistrosPorPagina();
            var total = Math.ceil(visibleRows.length / porPagina) || 1;

            // Evitar que la página actual quede fuera del rango.
            if (paginaActual > total) {
                paginaActual = total;
            }

            var desde = (paginaActual - 1) * porPagina;
            var hasta = desde + porPagina;

            // Ocultar todas las filas inicialmente.
            allRows.forEach(function (r) {
                r.style.display = 'none';
            });

            // Mostrar únicamente los registros de la página actual.
            visibleRows.forEach(function (r, idx) {
                if (idx >= desde && idx < hasta) {
                    r.style.display = '';
                }
            });

            renderPaginacion(total);
        }

        /* ── Filtrado ───────────────────────── */
        function aplicarFiltros() {
            var rol = document.getElementById('filterRol').value;
            var estado = document.getElementById('filterEstado').value;
            var desdeVal = document.getElementById('filterFechaDesde').value;
            var hastaVal = document.getElementById('filterFechaHasta').value;

            var rows = Array.from(document.querySelectorAll('#cuerpoTabla tr'));
            rows.forEach(function (r) {
                var rr = (r.dataset.rol || '').trim();
                var re = (r.dataset.estado || '').trim();
                var rf = r.dataset.fecha ? r.dataset.fecha.substring(0, 10) : '';

                var ocultar = false;

                if (rol && rr !== rol) ocultar = true;
                if (estado && re !== estado) ocultar = true;
                if (desdeVal && (!rf || rf < desdeVal)) ocultar = true;
                if (hastaVal && (!rf || rf > hastaVal)) ocultar = true;

                r.dataset.filtered = ocultar ? 'true' : 'false';
                r.style.display = ocultar ? 'none' : '';
            });

            paginaActual = 1;
            aplicar();
        }

        function limpiarFiltros() {
            document.getElementById('filterRol').value = '';
            document.getElementById('filterEstado').value = '';
            document.getElementById('filterFechaDesde').value = '';
            document.getElementById('filterFechaHasta').value = '';

            var rows = Array.from(document.querySelectorAll('#cuerpoTabla tr'));
            rows.forEach(function (r) {
                r.dataset.filtered = 'false';
                r.style.display = '';
            });

            paginaActual = 1;
            aplicar();
        }

        // enlazar eventos
        var btnApply = document.getElementById('btnFilterApply');
        var btnReset = document.getElementById('btnFilterReset');

        if (btnApply) {
            btnApply.addEventListener('click', function (e) {
                e.preventDefault();
                aplicarFiltros();
            });
        }

        if (btnReset) {
            btnReset.addEventListener('click', function (e) {
                e.preventDefault();
                limpiarFiltros();
            });
        }

        aplicar();

        var resizeTimer;
        window.addEventListener('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                paginaActual = 1;
                aplicar();
            }, 150);
        });
    }());
    </script>
}
