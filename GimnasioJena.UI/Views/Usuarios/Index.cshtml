@model IEnumerable<GimnasioJena.Abstracciones.Modelos.Usuarios.UsuarioListadoDto>

@{
    ViewBag.Title = "Gestión de usuarios";
    var entrenadores = ViewBag.Entrenadores as List<GimnasioJena.Abstracciones.Modelos.Entrenadores.EntrenadorListadoDto>
                       ?? new List<GimnasioJena.Abstracciones.Modelos.Entrenadores.EntrenadorListadoDto>();
}

<div class="container py-5">
    <a href="javascript:history.back()" class="btn btn-volver" aria-label="Volver">
        <i class="bi bi-arrow-left"></i> Atrás
    </a>

    <div class="mb-5">
        <h1 class="page-title">Gestión de usuarios</h1>
        <p class="text-muted">Administre los usuarios registrados, sus roles y el acceso al sistema.</p>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success" id="alertaExito">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger" id="alertaError">
            @TempData["MensajeError"]
        </div>
    }

    <div class="info-card info-card-tabla">
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                No hay usuarios registrados.
            </div>
        }
        else
        {
            <div class="table-jena-wrapper">
                <table class="table-jena">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Identificación</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Rol actual</th>
                            <th>Estado</th>
                            <th>Fecha registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="cuerpoTabla">
                        @foreach (var usuario in Model)
                        {
                            var entrenador = entrenadores.FirstOrDefault(e => e.idUsuario == usuario.idUsuario);

                            string badgeRol;
                            if (usuario.rol == "ADMINISTRADOR") { badgeRol = "badge-jena-admin"; }
                            else if (usuario.rol == "ENTRENADOR") { badgeRol = "badge-jena-coach"; }
                            else { badgeRol = "badge-jena-client"; }

                            <tr>
                                <td data-label="Nombre">@usuario.nombreCompleto</td>
                                <td data-label="Identificación">@usuario.identificacion</td>
                                <td data-label="Correo">@usuario.correo</td>
                                <td data-label="Teléfono">@usuario.telefono</td>
                                <td data-label="Rol actual">
                                    <span class="@badgeRol">@usuario.rol</span>
                                </td>
                                <td data-label="Estado">
                                    @if (usuario.estado)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td data-label="Fecha registro">@usuario.fechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td class="td-acciones">
                                    <div class="d-flex gap-1 flex-wrap justify-content-center">
                                        <button type="button" class="btn btn-sm btn-action-jena"
                                                onclick="cargarVistaModalRol('@usuario.identityUserId')">
                                            <i class="bi bi-shield-lock me-1"></i>Cambiar rol
                                        </button>
                                        @if (entrenador != null)
                                        {
                                            <button type="button" class="btn btn-sm btn-action-jena"
                                                    onclick="cargarVistaModalEntrenador(@entrenador.idEntrenador)">
                                                <i class="bi bi-person-badge me-1"></i>Editar entrenador
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="paginacion-info" id="paginacionInfo"></p>
            <div id="paginacion-mobile" class="paginacion-mobile-wrapper"></div>
        }
    </div>
</div>

<!-- Modal: Cambiar Rol -->
<div class="modal fade" id="modalDinamicoRol" tabindex="-1" aria-labelledby="modalRolLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalRolLabel">Cambiar rol de usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalDinamicoRolBody">
            </div>
        </div>
    </div>
</div>

<!-- Modal: Editar Entrenador -->
<div class="modal fade" id="modalDinamicoEntrenador" tabindex="-1" aria-labelledby="modalEntrenadorLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEntrenadorLabel">Editar información del entrenador</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalDinamicoEntrenadorBody">
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function cargarVistaModalRol(identityUserId) {
        var url = '@Url.Action("CambiarRol", "Usuarios")?identityUserId=' + encodeURIComponent(identityUserId);
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); })
            .then(function (html) {
                document.getElementById('modalDinamicoRolBody').innerHTML = html;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalDinamicoRol')).show();
                interceptarFormModal('modalDinamicoRol');
            })
            .catch(function () { alert('Error al cargar el formulario.'); });
    }

    function cargarVistaModalEntrenador(idEntrenador) {
        var url = '@Url.Action("Editar", "Entrenadores")/' + idEntrenador;
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text(); })
            .then(function (html) {
                document.getElementById('modalDinamicoEntrenadorBody').innerHTML = html;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalDinamicoEntrenador')).show();
                interceptarFormModal('modalDinamicoEntrenador');
            })
            .catch(function () { alert('Error al cargar el formulario.'); });
    }

    function interceptarFormModal(modalId) {
        var modalEl = document.getElementById(modalId);
        var form = modalEl.querySelector('form');
        if (!form) return;

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var formData = new FormData(form);
            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function (r) {
                if (r.ok) {
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                    window.location.reload();
                } else {
                    return r.text().then(function (html) {
                        modalEl.querySelector('.modal-body').innerHTML = html;
                        interceptarFormModal(modalId);
                    });
                }
            })
            .catch(function () { alert('Error al guardar los cambios.'); });
        });
    }

    /* ── Paginación mobile ─────────────────────────────────── */
    (function () {
        var POR_PAGINA = 2;
        var paginaActual = 1;

        function esMobile() { return window.innerWidth < 768; }

        function filas() {
            return Array.from(document.querySelectorAll('#cuerpoTabla tr'));
        }

        function renderPaginacion(totalPaginas) {
            var container = document.getElementById('paginacion-mobile');
            var info      = document.getElementById('paginacionInfo');
            if (!container) return;

            if (!esMobile() || totalPaginas <= 1) {
                container.style.display = 'none';
                if (info) info.style.display = 'none';
                return;
            }

            if (info) {
                var desde = (paginaActual - 1) * POR_PAGINA + 1;
                var hasta = Math.min(paginaActual * POR_PAGINA, filas().length);
                info.textContent = 'Mostrando ' + desde + '–' + hasta + ' de ' + filas().length + ' usuarios';
                info.style.display = 'block';
            }

            var html = '<ul class="pagination-jena">';

            html += '<li class="page-jena-item' + (paginaActual === 1 ? ' disabled' : '') + '">'
                  + '<button class="page-jena-btn" data-p="' + (paginaActual - 1) + '" aria-label="Anterior">'
                  + '<i class="bi bi-chevron-left"></i></button></li>';

            for (var i = 1; i <= totalPaginas; i++) {
                html += '<li class="page-jena-item' + (i === paginaActual ? ' active' : '') + '">'
                      + '<button class="page-jena-btn" data-p="' + i + '">' + i + '</button></li>';
            }

            html += '<li class="page-jena-item' + (paginaActual === totalPaginas ? ' disabled' : '') + '">'
                  + '<button class="page-jena-btn" data-p="' + (paginaActual + 1) + '" aria-label="Siguiente">'
                  + '<i class="bi bi-chevron-right"></i></button></li>';

            html += '</ul>';
            container.innerHTML = html;
            container.style.display = 'flex';

            container.querySelectorAll('.page-jena-btn[data-p]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    irAPagina(parseInt(this.getAttribute('data-p')));
                });
            });
        }

        function irAPagina(p) {
            var total = Math.ceil(filas().length / POR_PAGINA);
            if (p < 1 || p > total) return;
            paginaActual = p;
            aplicar();
        }

        function aplicar() {
            var rows  = filas();
            var total = Math.ceil(rows.length / POR_PAGINA);

            if (!esMobile()) {
                rows.forEach(function (r) { r.style.display = ''; });
                var c = document.getElementById('paginacion-mobile');
                var i = document.getElementById('paginacionInfo');
                if (c) c.style.display = 'none';
                if (i) i.style.display = 'none';
                return;
            }

            var desde = (paginaActual - 1) * POR_PAGINA;
            var hasta = desde + POR_PAGINA;
            rows.forEach(function (r, idx) {
                r.style.display = (idx >= desde && idx < hasta) ? '' : 'none';
            });
            renderPaginacion(total);
        }

        aplicar();

        var resizeTimer;
        window.addEventListener('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                paginaActual = 1;
                aplicar();
            }, 150);
        });
    }());
</script>
}
