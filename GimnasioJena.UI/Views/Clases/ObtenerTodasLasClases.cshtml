@model IEnumerable<GimnasioJena.Abstracciones.Modelos.Clases.ClaseListadoDto>

@{
    bool esVistaCliente =
        ViewBag.EsVistaCliente != null &&
        (bool)ViewBag.EsVistaCliente;

    ViewBag.Title = esVistaCliente
        ? "Próximas Clases"
        : "Gestión de Clases";
}

<div class="container py-5">

    <!-- Encabezado -->
    <div class="welcome-section mb-4">
        <div class="welcome-text">
            @if (esVistaCliente)
            {
                <h3>Próximas Clases</h3>
                <p>
                    Consulta las próximas clases disponibles.
                    Las reservas se habilitan 24 horas antes y se cierran
                    10 minutos antes del inicio.
                </p>
            }
            else
            {
                <h3>Gestión de Clases</h3>
                <p>
                    Listado completo de todas las clases programadas en el sistema.
                </p>
            }
        </div>
    </div>

    <!-- Mensajes -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    <!-- Información administrativa -->
    @if (!esVistaCliente)
    {
        int statTotal = Model != null ? Model.Count() : 0;

        int statCupos = Model != null
            ? Model.Sum(c => c.cuposDisponibles)
            : 0;

        int statActivas = Model != null
            ? Model.Count(c => c.estadoClase == "Activa")
            : 0;

        int statInstructores = Model != null
            ? Model
                .Where(c => !string.IsNullOrWhiteSpace(c.nombreEntrenador))
                .Select(c => c.nombreEntrenador)
                .Distinct()
                .Count()
            : 0;

        <div class="stats-grid mb-4">

            <div class="stat-card">
                <i class="bi bi-calendar-check"></i>
                <h3>@statTotal</h3>
                <p>Total clases</p>
            </div>

            <div class="stat-card">
                <i class="bi bi-people"></i>
                <h3>@statCupos</h3>
                <p>Cupos disponibles</p>
            </div>

            <div class="stat-card">
                <i class="bi bi-check-circle"></i>
                <h3>@statActivas</h3>
                <p>Clases activas</p>
            </div>

            <div class="stat-card">
                <i class="bi bi-person-badge"></i>
                <h3>@statInstructores</h3>
                <p>Entrenadores</p>
            </div>

        </div>

        <!-- Filtros administrativos -->
        <div class="info-card mb-4">

            <div class="row align-items-end g-3">

                <div class="col-md-3">
                    <label class="info-label mb-1">
                        <i class="bi bi-funnel me-1"></i>
                        Tipo de clase
                    </label>

                    <select class="form-select" id="filtroTipo">
                        <option value="">Todas las clases</option>

                        @if (Model != null)
                        {
                            foreach (var nombre in Model
                                .Where(c => !string.IsNullOrWhiteSpace(c.nombreClase))
                                .Select(c => c.nombreClase)
                                .Distinct()
                                .OrderBy(n => n))
                            {
                                <option value="@nombre.ToLower()">
                                    @nombre
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="info-label mb-1">
                        <i class="bi bi-toggle-on me-1"></i>
                        Estado
                    </label>

                    <select class="form-select" id="filtroEstado">
                        <option value="">Todos</option>
                        <option value="activa">Activas</option>
                        <option value="inactiva">Inactivas</option>
                        <option value="cancelada">Canceladas</option>
                        <option value="finalizada">Finalizadas</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="info-label mb-1">
                        <i class="bi bi-sort-down me-1"></i>
                        Ordenar por
                    </label>

                    <select class="form-select" id="filtroOrden">
                        <option value="">Seleccionar</option>
                        <option value="instructor">Entrenador</option>
                        <option value="cupos">Cupos disponibles</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <button type="button"
                            class="btn-orange w-100"
                            onclick="aplicarFiltros()">
                        <i class="bi bi-search me-2"></i>
                        Buscar
                    </button>
                </div>

            </div>
        </div>

        <!-- Crear clase -->
        <div class="mb-4 d-flex justify-content-end">
            @Html.ActionLink(
                "+ Crear nueva clase",
                "RegistrarClase",
                "Clases",
                null,
                new { @class = "btn-orange" }
            )
        </div>
    }

    <!-- Lista de clases -->
    <div id="listaClases">

        @if (Model == null || !Model.Any())
        {
            <div class="info-card text-center py-5">

                <i class="bi bi-calendar-x icon-jena-3xl">
                </i>

                @if (esVistaCliente)
                {
                    <h4 class="mt-3">No hay próximas clases disponibles</h4>

                    <p class="mb-0">
                        Actualmente no existen clases futuras programadas.
                    </p>
                }
                else
                {
                    <h4 class="mt-3">No hay clases registradas</h4>

                    <p class="mb-0">
                        Actualmente no existen clases programadas en el sistema.
                    </p>
                }

            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                string tipo = item.nombreClase ?? "";
                string tipoLower = tipo.ToLower();

                string estadoLower =
                    !string.IsNullOrWhiteSpace(item.estadoClase)
                        ? item.estadoClase.ToLower()
                        : "";

                string iconoClase =
                    tipoLower.Contains("fuerza")
                        ? "bi-lightning-charge"
                        : tipoLower.Contains("acondicionamiento")
                            ? "bi-activity"
                            : tipoLower.Contains("cruzado")
                                ? "bi-trophy"
                                : tipoLower.Contains("hiit")
                                    ? "bi-fire"
                                    : tipoLower.Contains("movilidad")
                                        ? "bi-person-arms-up"
                                        : "bi-calendar-event";

                int pctOcupado = item.cupoMaximo > 0
                    ? (int)Math.Round(
                        (double)item.cuposReservados /
                        item.cupoMaximo * 100)
                    : 0;

                string colorBarra =
                    pctOcupado >= 80
                        ? "var(--jena-orange)"
                        : pctOcupado >= 50
                            ? "#f0ad4e"
                            : "var(--jena-light-blue)";

                bool esActiva =
                    item.estadoClase == "Activa";

                string badgeTexto =
                    !string.IsNullOrWhiteSpace(item.estadoClase)
                        ? item.estadoClase
                        : "Sin estado";

                string badgeIcono =
                    esActiva
                        ? "bi-check-circle"
                        : "bi-x-circle";
                <div class="clase-item mb-3"
                     data-tipo="@tipoLower"
                     data-estado="@estadoLower"
                     data-instructor="@item.nombreEntrenador"
                     data-cupos="@item.cuposDisponibles">

                    <div class="info-card p-0 overflow-hidden">

                        <div class="row g-0 align-items-stretch">

                            <!-- Ícono -->
                            <div class="col-3 col-md-2 d-flex
                                        align-items-center
                                        justify-content-center card-panel-navy">

                                <i class="bi @iconoClase icon-jena-3xl">
                                </i>

                            </div>

                            <!-- Información -->
                            <div class="col-9 col-md-8 p-3">

                                <div class="d-flex flex-wrap gap-2 mb-2">

                                    <!-- Estado -->
                                    <span class="@(esActiva ? "badge-activa" : "badge-inactiva")">

                                        <i class="bi @badgeIcono"></i>
                                        @badgeTexto

                                    </span>

                                    <!-- Cupos -->
                                    @if (item.cuposDisponibles > 0)
                                    {
                                        <span class="badge-disponible">

                                            <i class="bi bi-people"></i>

                                            @item.cuposDisponibles
                                            @(item.cuposDisponibles == 1
                                                ? "cupo disponible"
                                                : "cupos disponibles")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-llena">

                                            <i class="bi bi-x-circle"></i>
                                            Sin cupos

                                        </span>
                                    }

                                </div>

                                <h5 class="card-clase-title">

                                    @item.nombreClase

                                </h5>

                                <div class="row g-2 text-clase-body">

                                    <!-- Entrenador -->
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <i class="bi bi-person-badge text-accent">
                                        </i>

                                        @item.nombreEntrenador
                                    </div>

                                    <!-- Ubicación solamente para admin -->
                                    @if (!esVistaCliente)
                                    {
                                        <div class="col-12 col-sm-6 col-lg-3">
                                            <i class="bi bi-geo-alt text-accent">
                                            </i>

                                            @(string.IsNullOrWhiteSpace(item.ubicacion)
                                                ? "Sin ubicación"
                                                : item.ubicacion)
                                        </div>
                                    }

                                    <!-- Cupos -->
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <i class="bi bi-people text-accent">
                                        </i>

                                        @if (esVistaCliente)
                                        {
                                            <span>
                                                @item.cuposDisponibles disponibles
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @item.cuposReservados de @item.cupoMaximo reservados
                                            </span>
                                        }
                                    </div>

                                    <!-- Fecha -->
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <i class="bi bi-calendar-date text-accent">
                                        </i>

                                        @item.fechaClase.ToString("dd/MM/yyyy")
                                    </div>

                                    <!-- Horario -->
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <i class="bi bi-clock text-accent">
                                        </i>

                                        @item.horaInicio.ToString(@"hh\:mm")
                                        -
                                        @item.horaFin.ToString(@"hh\:mm")
                                    </div>

                                </div>

                                <!-- Ocupación solo para administrador -->
                                @if (!esVistaCliente)
                                {
                                    <div class="mt-3">

                                        <div class="d-flex
                                                    justify-content-between text-clase-label">

                                            <span>Ocupación</span>
                                            <span>@pctOcupado%</span>

                                        </div>

                                        <div class="progress-bar-bg">

                                            <div class="progress-bar-fill"
                                                 style="--bar-w: @(pctOcupado)%; --bar-col: @colorBarra;">
                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                            <!-- Acciones -->
                            <div class="col-12 col-md-2 clase-acciones d-flex
                                        flex-row flex-md-column
                                        align-items-center
                                        justify-content-center
                                        p-3
                                        gap-2">

                                @if (User.IsInRole("ADMINISTRADOR"))
                                {
                                    @Html.ActionLink(
                                        "Editar",
                                        "EditarClase",
                                        "Clases",
                                        new
                                        {
                                            id = item.idClaseProgramada
                                        },
                                        new
                                        {
                                            @class = "btn-action"
                                        }
                                    )
                                }

                                @if (esVistaCliente)
                                {
                                    if (item.reservaHabilitada)
                                    {
                                        @Html.ActionLink(
                                            "Reservar clase",
                                            "ReservarClase",
                                            "Reservas",
                                            new
                                            {
                                                id = item.idClaseProgramada
                                            },
                                            new
                                            {
                                                @class = "btn-action"
                                            }
                                        )
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-secondary"
                                                disabled>
                                            No disponible
                                        </button>
                                    }

                                    <small class="text-center text-muted">
                                        @item.mensajeReserva
                                    </small>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }
        }

    </div>

    <div id="paginacionClases" class="mt-3 mb-2"></div>

</div>

<script>
(function () {
    var ITEMS_DESKTOP = 5;
    var ITEMS_MOBILE  = 1;
    var paginaActual  = 1;

    function getItemsPorPagina() {
        return window.innerWidth <= 768 ? ITEMS_MOBILE : ITEMS_DESKTOP;
    }

    window.aplicarFiltros = function () {
        var filtroTipoEl   = document.getElementById('filtroTipo');
        var filtroEstadoEl = document.getElementById('filtroEstado');
        var filtroOrdenEl  = document.getElementById('filtroOrden');

        var tipo   = filtroTipoEl   ? filtroTipoEl.value.toLowerCase()   : '';
        var estado = filtroEstadoEl ? filtroEstadoEl.value.toLowerCase() : '';
        var orden  = filtroOrdenEl  ? filtroOrdenEl.value                : '';

        var items = Array.from(document.querySelectorAll('.clase-item'));

        items.forEach(function (item) {
            var matchTipo   = !tipo   || item.dataset.tipo.includes(tipo);
            var matchEstado = !estado || item.dataset.estado === estado;
            item.dataset.visible = (matchTipo && matchEstado) ? '1' : '0';
        });

        if (orden) {
            var contenedor = document.getElementById('listaClases');
            var vis = items.filter(function (i) { return i.dataset.visible === '1'; });
            vis.sort(function (a, b) {
                if (orden === 'instructor') return a.dataset.instructor.localeCompare(b.dataset.instructor);
                if (orden === 'cupos')      return parseInt(b.dataset.cupos) - parseInt(a.dataset.cupos);
                return 0;
            });
            vis.forEach(function (item) { contenedor.appendChild(item); });
        }

        paginaActual = 1;
        renderPagina();
    };

    function renderPagina() {
        var items        = Array.from(document.querySelectorAll('.clase-item'));
        var visibles     = items.filter(function (i) { return i.dataset.visible !== '0'; });
        var porPagina    = getItemsPorPagina();
        var totalPaginas = Math.max(1, Math.ceil(visibles.length / porPagina));

        if (paginaActual > totalPaginas) { paginaActual = totalPaginas; }

        var inicio = (paginaActual - 1) * porPagina;
        var fin    = inicio + porPagina;

        items.forEach(function (item) { item.style.display = 'none'; });
        visibles.forEach(function (item, idx) {
            item.style.display = (idx >= inicio && idx < fin) ? '' : 'none';
        });

        renderControlesPaginacion(totalPaginas, visibles.length);
    }

    function renderControlesPaginacion(totalPaginas, totalItems) {
        var contenedor = document.getElementById('paginacionClases');
        if (!contenedor) { return; }

        if (totalPaginas <= 1) {
            contenedor.innerHTML = '';
            return;
        }

        var html = '<nav aria-label="Paginacion"><ul class="pagination justify-content-center flex-wrap mb-0">';

        html += '<li class="page-item' + (paginaActual === 1 ? ' disabled' : '') + '">' +
                '<a class="page-link" href="javascript:void(0)" onclick="cambiarPagina(' + (paginaActual - 1) + ')">' +
                '<i class="bi bi-chevron-left"></i></a></li>';

        for (var p = 1; p <= totalPaginas; p++) {
            html += '<li class="page-item' + (p === paginaActual ? ' active' : '') + '">' +
                    '<a class="page-link" href="javascript:void(0)" onclick="cambiarPagina(' + p + ')">' +
                    p + '</a></li>';
        }

        html += '<li class="page-item' + (paginaActual === totalPaginas ? ' disabled' : '') + '">' +
                '<a class="page-link" href="javascript:void(0)" onclick="cambiarPagina(' + (paginaActual + 1) + ')">' +
                '<i class="bi bi-chevron-right"></i></a></li>';

        html += '</ul></nav>';
        contenedor.innerHTML = html;
    }

    window.cambiarPagina = function (pagina) {
        var items        = Array.from(document.querySelectorAll('.clase-item'));
        var visibles     = items.filter(function (i) { return i.dataset.visible !== '0'; });
        var porPagina    = getItemsPorPagina();
        var totalPaginas = Math.max(1, Math.ceil(visibles.length / porPagina));
        if (pagina < 1 || pagina > totalPaginas) { return; }
        paginaActual = pagina;
        renderPagina();
        var lista = document.getElementById('listaClases');
        if (lista) { lista.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    };

    // Iniciar: el DOM ya está renderizado porque este script está al final del body
    Array.from(document.querySelectorAll('.clase-item')).forEach(function (item) {
        item.dataset.visible = '1';
    });
    renderPagina();

    var resizeTimer;
    window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(renderPagina, 150);
    });
}());
</script>