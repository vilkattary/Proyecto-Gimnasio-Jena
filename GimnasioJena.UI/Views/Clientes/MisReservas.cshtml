@using System.Linq
@using System.Web.Helpers
@model IEnumerable<GimnasioJena.Abstracciones.Modelos.Reservas.ReservaListadoDto>


@{
    ViewBag.Title = "MisReservas";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />
<div class="container-fluid p-4">

    <div class="mb-5">
        <h1 class="page-title">Calendario de Reservas</h1>
        <p class="text-muted">Visualiza y gestiona todas tus reservas de clases.</p>
    </div>

    <!-- Estadísticas Rápidas -->
    <div class="stats-section">
        <div class="stat-card">
            <i class="bi bi-calendar-check"></i>
            <h3>@(Model == null ? 0 : Model.Count(r => r.idEstadoReserva == 1))</h3>
            <p>Reservas Activas</p>
        </div>
        <div class="stat-card">
            <i class="bi bi-clock-history"></i>
            <h3>—</h3>
            <p>Clases Tomadas</p>
        </div>
        <div class="stat-card">
            <i class="bi bi-trophy"></i>
            <h3>—</h3>
            <p>Asistencia</p>
        </div>
    </div>

    <div class="row">
        <!-- Columna del Calendario -->
        <div class="col-lg-6 mb-4">
            <div class="section-header">
                <h5><i class="bi bi-calendar3 me-2"></i>Vista Mensual</h5>
                <p>Selecciona una fecha para ver los detalles</p>
            </div>
            <div class="calendar-wrapper">
                <div id="calendar"></div>
            </div>
        </div>

        <!-- Columna de Reservas -->
        <div class="col-lg-6">
            <div class="section-header">
                <h5><i class="bi bi-bookmark-check me-2"></i>Próximas Clases</h5>
                <p>Tus reservas confirmadas</p>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="empty-state text-center p-4">
                    <i class="bi bi-calendar-x"></i>
                    <h4>No tienes reservas</h4>
                    <p>Reserva una clase para ver las próximas sesiones aquí.</p>
                    <a href="@Url.Action("ObtenerTodasLasClases", "Clases")" class="btn-action">Reservar clases</a>
                </div>
            }
            else
            {
                foreach (var r in Model)
                {
                    <div class="reservation-card">
                        <div class="card-icon">
                            <i class="bi bi-calendar-event"></i>
                        </div>
                        <h4>@r.nombreClase</h4>

                        <div class="info-item">
                            <i class="bi bi-person-badge"></i>
                            <span>Instructor: <strong>@r.nombreEntrenador</strong></span>
                        </div>

                        <div class="info-item">
                            <i class="bi bi-calendar-event"></i>
                            <span>Fecha: <strong>@r.fechaClase.ToString("dd/MM/yyyy")</strong></span>
                        </div>

                        <div class="info-item">
                            <i class="bi bi-clock"></i>
                            <span>Hora: <strong>@r.horaInicio.ToString(@"hh\:mm") - @r.horaFin.ToString(@"hh\:mm")</strong></span>
                        </div>

                        <div class="info-item">
                            <i class="bi bi-geo-alt"></i>
                            <span>Lugar: <strong>@r.ubicacion</strong></span>
                        </div>

                        <div class="mt-3 d-flex gap-2 flex-wrap">

                            <a href="@Url.Action("DetalleReserva", "Clientes", new { id = r.idReserva })"
                               class="btn-detail">
                                <i class="bi bi-eye"></i>
                                <span>Ver Detalle</span>
                            </a>

                            @if (r.idEstadoReserva == 1)
                            {
                                using (Html.BeginForm("CancelarReserva", "Clientes", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.idReserva" />

                                    <button type="submit"
                                            class="btn btn-cancel"
                                            onclick="return confirm('¿Estás seguro de cancelar esta reserva?')">
                                        <i class="bi bi-x-circle"></i>
                                        <span>Cancelar Reserva</span>
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary p-2 align-self-center">
                                    @r.estadoReserva
                                </span>
                            }

                        </div>
                    </div>
                }
            }

            <!-- Botón para Reservar Más -->
            <div class="text-center mt-4">
                <a href="@Url.Action("ObtenerTodasLasClases", "Clases")" class="btn-action">
                    <i class="bi bi-calendar-plus"></i>
                    <span>Reservar Más Clases</span>
                </a>
            </div>
        </div>
    </div>
</div>

@{
    var eventosCalendario = (Model ?? Enumerable.Empty<GimnasioJena.Abstracciones.Modelos.Reservas.ReservaListadoDto>())
        .Select(r => new
        {
            title = r.nombreClase,
            start = r.fechaClase.ToString("yyyy-MM-dd") + "T" + r.horaInicio.ToString(),
            end = r.fechaClase.ToString("yyyy-MM-dd") + "T" + r.horaFin.ToString(),
            entrenador = r.nombreEntrenador,
            estado = r.estadoReserva,
            ubicacion = r.ubicacion
        })
        .ToList();
}

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'es',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth'
            },
            buttonText: {
                today: 'Hoy',
                month: 'Mes'
            },
            events: @Html.Raw(Json.Encode(eventosCalendario)),
            eventClick: function (info) {
                alert(
                    'Clase: ' + info.event.title +
                    '\nEntrenador: ' + info.event.extendedProps.entrenador +
                    '\nEstado: ' + info.event.extendedProps.estado +
                    '\nLugar: ' + info.event.extendedProps.ubicacion +
                    '\nFecha: ' + info.event.start.toLocaleDateString('es-ES')
                );
            }
        });

        calendar.render();
    });
</script>