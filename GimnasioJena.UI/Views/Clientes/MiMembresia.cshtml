@model GimnasioJena.Abstracciones.Modelos.Membresias.MembresiaClienteDto

@{
    ViewBag.Title = "Mi Membresía";
    Layout = "~/Views/Shared/_Layout.cshtml";

    DateTime hoy = DateTime.Today;

    bool tieneMembresia = Model != null;

    bool esVigente =
        tieneMembresia &&
        Model.estadoMembresia == "Activa" &&
        Model.fechaInicio.Date <= hoy &&
        Model.fechaFin.Date >= hoy;

    bool puedeRenovarOCambiar =
        tieneMembresia &&
        Model.fechaFin.Date <= hoy;

    bool esTop =
        tieneMembresia &&
        !String.IsNullOrWhiteSpace(Model.nombrePlan) &&
        Model.nombrePlan.ToUpper().Contains("TOP");

    bool esRoot =
        tieneMembresia &&
        !String.IsNullOrWhiteSpace(Model.nombrePlan) &&
        Model.nombrePlan.ToUpper().Contains("ROOT");
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="page-title">Mi Membresía</h1>

        <p class="text-muted">
            Consulta la información de tu plan actual y su periodo de vigencia.
        </p>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    @if (!tieneMembresia)
    {
        <div class="info-card text-center">

            <div class="mb-4">
                <i class="bi bi-person-badge display-4 text-muted"></i>
            </div>

            <h3 class="mb-3">
                Todavía no tienes una membresía
            </h3>

            <p class="text-muted mb-4">
                Para reservar clases y disfrutar de los beneficios de Jéna,
                primero debes adquirir uno de nuestros planes.
            </p>

            <div class="row justify-content-center">

                <div class="col-md-5 mb-3">
                    <div class="border rounded-4 p-4 h-100">

                        <h4 class="fw-bold">
                            Jéna COLLECTIVE CNS ROOT
                        </h4>

                        <p class="text-muted">
                            Plan de 31 días con 12 clases disponibles.
                        </p>

                        <h3 class="info-value">
                            ₡31,900.00
                        </h3>

                        <button type="button"
                                class="btn btn-action mt-3"
                                disabled
                                title="Disponible próximamente con el módulo de pagos">
                            <i class="bi bi-cart-plus me-1"></i>
                            Comprar próximamente
                        </button>

                    </div>
                </div>

                <div class="col-md-5 mb-3">
                    <div class="border rounded-4 p-4 h-100">

                        <h4 class="fw-bold">
                            Jéna COLLECTIVE CNS TOP
                        </h4>

                        <p class="text-muted">
                            Plan de 31 días con clases ilimitadas.
                        </p>

                        <h3 class="info-value">
                            ₡36,900.00
                        </h3>

                        <button type="button"
                                class="btn btn-action mt-3"
                                disabled
                                title="Disponible próximamente con el módulo de pagos">
                            <i class="bi bi-cart-plus me-1"></i>
                            Comprar próximamente
                        </button>

                    </div>
                </div>

            </div>

        </div>
    }
    else
    {
        <div class="info-card">

            <div class="row align-items-center">

                <div class="col-lg-8 mb-4 mb-lg-0">

                    <div class="d-flex align-items-center gap-2 mb-3">

                        @if (Model.estadoMembresia == "Activa")
                        {
                            <span class="badge bg-success fs-6">
                                <i class="bi bi-check-circle me-1"></i>
                                Activa
                            </span>
                        }
                        else if (Model.estadoMembresia == "Vencida")
                        {
                            <span class="badge bg-danger fs-6">
                                <i class="bi bi-x-circle me-1"></i>
                                Vencida
                            </span>
                        }
                        else if (Model.estadoMembresia == "Suspendida")
                        {
                            <span class="badge bg-warning text-dark fs-6">
                                <i class="bi bi-pause-circle me-1"></i>
                                Suspendida
                            </span>
                        }
                        else if (Model.estadoMembresia == "Inactiva")
                        {
                            <span class="badge bg-secondary fs-6">
                                <i class="bi bi-dash-circle me-1"></i>
                                Inactiva
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-dark fs-6">
                                @Model.estadoMembresia
                            </span>
                        }

                    </div>

                    <h2 class="info-value mb-3">
                        @Model.nombrePlan
                    </h2>

                    @if (esRoot)
                    {
                        <p class="text-muted">
                            Tu plan ROOT incluye 12 clases para utilizar
                            durante un periodo de 31 días.
                        </p>
                    }
                    else if (esTop)
                    {
                        <p class="text-muted">
                            Tu plan TOP permite reservar clases de forma
                            ilimitada durante un periodo de 31 días.
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">
                            Información correspondiente a tu plan de membresía.
                        </p>
                    }

                    <div class="row mt-4">

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-muted">
                                Fecha de inicio
                            </label>

                            <div class="fs-5">
                                <i class="bi bi-calendar-check me-1"></i>
                                @Model.fechaInicio.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-muted">
                                Fecha de vencimiento
                            </label>

                            <div class="fs-5">
                                <i class="bi bi-calendar-x me-1"></i>
                                @Model.fechaFin.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-muted">
                                Precio del plan
                            </label>

                            <div class="fs-5">
                                ₡ @Model.precio.ToString("N2")
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-muted">
                                Clases disponibles
                            </label>

                            <div class="fs-5">

                                @if (Model.clasesDisponibles.HasValue)
                                {
                                    <i class="bi bi-ticket-perforated me-1"></i>

                                    <span>
                                        @Model.clasesDisponibles.Value de 12
                                    </span>
                                }
                                else
                                {
                                    <i class="bi bi-infinity me-1"></i>

                                    <span>
                                        Ilimitadas
                                    </span>
                                }

                            </div>
                        </div>

                    </div>

                    @if (!String.IsNullOrWhiteSpace(Model.observaciones))
                    {
                        <div class="mt-3">

                            <label class="fw-bold text-muted">
                                Observaciones
                            </label>

                            <div class="border rounded p-3 bg-light mt-1">
                                @Model.observaciones
                            </div>

                        </div>
                    }

                </div>

                <div class="col-lg-4">

                    <div class="border rounded-4 p-4 text-center bg-light">

                        @if (esVigente)
                        {
                            <i class="bi bi-shield-check display-4 text-success"></i>

                            <h4 class="mt-3">
                                Membresía vigente
                            </h4>

                            <p class="text-muted">
                                Puedes reservar clases mientras tu membresía
                                se encuentre activa y tenga disponibilidad.
                            </p>

                            <a href="@Url.Action(
                                         "ObtenerTodasLasClases",
                                         "Clases")"
                               class="btn btn-action w-100 mb-2">

                                <i class="bi bi-calendar-plus me-1"></i>
                                Reservar clases

                            </a>

                            if (Model.fechaFin.Date > hoy)
                            {
                                <button type="button"
                                        class="btn btn-outline-secondary w-100"
                                        disabled>

                                    <i class="bi bi-clock me-1"></i>

                                    Renovación disponible el
                                    @Model.fechaFin.ToString("dd/MM/yyyy")

                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-outline-success w-100"
                                        disabled
                                        title="Se habilitará con el módulo de pagos">

                                    <i class="bi bi-arrow-clockwise me-1"></i>
                                    Renovar o cambiar plan próximamente

                                </button>
                            }
                        }
                        else if (puedeRenovarOCambiar)
                        {
                            <i class="bi bi-exclamation-circle display-4 text-danger"></i>

                            <h4 class="mt-3">
                                Periodo finalizado
                            </h4>

                            <p class="text-muted">
                                Ya puedes renovar tu plan actual o seleccionar
                                otro plan para el siguiente periodo.
                            </p>

                            <button type="button"
                                    class="btn btn-action w-100"
                                    disabled
                                    title="Se habilitará con el módulo de pagos">

                                <i class="bi bi-arrow-clockwise me-1"></i>
                                Renovar o cambiar plan próximamente

                            </button>
                        }
                        else
                        {
                            <i class="bi bi-info-circle display-4 text-warning"></i>

                            <h4 class="mt-3">
                                Membresía no disponible
                            </h4>

                            <p class="text-muted">
                                Tu membresía se encuentra
                                @Model.estadoMembresia.ToLower().
                                Comunícate con la administración para obtener
                                más información.
                            </p>
                        }

                    </div>

                </div>

            </div>

        </div>

        <div class="info-card mt-4">

            <div class="text-center mb-4">
                <h3>Planes Jéna</h3>

                <p class="text-muted">
                    Podrás cambiar de plan el día del vencimiento de tu
                    membresía o después.
                </p>
            </div>

            <div class="row justify-content-center">

                <div class="col-md-5 mb-3">

                    <div class="border rounded-4 p-4 h-100">

                        <h4 class="fw-bold">
                            Jéna COLLECTIVE CNS ROOT
                        </h4>

                        <p class="text-muted">
                            12 clases disponibles durante 31 días.
                        </p>

                        <h3 class="info-value">
                            ₡31,900.00
                        </h3>

                        @if (esRoot && esVigente)
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary w-100"
                                    disabled>

                                <i class="bi bi-check-circle me-1"></i>
                                Plan actual

                            </button>
                        }
                        else if (!puedeRenovarOCambiar)
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary w-100"
                                    disabled>

                                Disponible al vencer tu membresía

                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-outline-gym w-100"
                                    disabled
                                    title="Se habilitará con el módulo de pagos">

                                Seleccionar próximamente

                            </button>
                        }

                    </div>

                </div>

                <div class="col-md-5 mb-3">

                    <div class="border rounded-4 p-4 h-100">

                        <h4 class="fw-bold">
                            Jéna COLLECTIVE CNS TOP
                        </h4>

                        <p class="text-muted">
                            Clases ilimitadas durante 31 días.
                        </p>

                        <h3 class="info-value">
                            ₡36,900.00
                        </h3>

                        @if (esTop && esVigente)
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary w-100"
                                    disabled>

                                <i class="bi bi-check-circle me-1"></i>
                                Plan actual

                            </button>
                        }
                        else if (!puedeRenovarOCambiar)
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary w-100"
                                    disabled>

                                Disponible al vencer tu membresía

                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-outline-gym w-100"
                                    disabled
                                    title="Se habilitará con el módulo de pagos">

                                Seleccionar próximamente

                            </button>
                        }

                    </div>

                </div>

            </div>

        </div>
    }

</div>