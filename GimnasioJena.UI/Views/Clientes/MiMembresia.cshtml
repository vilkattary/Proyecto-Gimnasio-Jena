@using System.Linq
@model GimnasioJena.Abstracciones.Modelos.Membresias.MiMembresiaViewModel

@{
    ViewBag.Title = "Mi Membresía";
    Layout = "~/Views/Shared/_Layout.cshtml";

    DateTime hoy = DateTime.Today;

    var planesDisponibles =
        Model != null && Model.planesDisponibles != null
            ? Model.planesDisponibles
            : new List<GimnasioJena.Abstracciones.Modelos.Membresias.PlanMembresiaListadoDto>();

    bool tieneMembresia =
        Model != null &&
        Model.membresiaActual != null;

    bool esVigente =
        tieneMembresia &&
        Model.membresiaActual.estadoMembresia == "Activa" &&
        Model.membresiaActual.fechaInicio.Date <= hoy &&
        Model.membresiaActual.fechaFin.Date >= hoy;

    bool puedeRenovarOCambiar =
        tieneMembresia &&
        Model.membresiaActual.fechaFin.Date <= hoy;

    bool esTop =
        tieneMembresia &&
        !String.IsNullOrWhiteSpace(
            Model.membresiaActual.nombrePlan) &&
        Model.membresiaActual.nombrePlan
            .ToUpper()
            .Contains("TOP");

    bool esRoot =
        tieneMembresia &&
        !String.IsNullOrWhiteSpace(
            Model.membresiaActual.nombrePlan) &&
        Model.membresiaActual.nombrePlan
            .ToUpper()
            .Contains("ROOT");

    var planActual =
        tieneMembresia
            ? planesDisponibles.FirstOrDefault(
                p => p.idPlanMembresia ==
                     Model.membresiaActual.idPlanMembresia)
            : null;
}

<div class="container py-5">

    <div class="mb-5">

        <h1 class="page-title">
            Mi Membresía
        </h1>

        <p class="text-muted">
            Consulta la información de tu plan actual y su periodo de vigencia.
        </p>

    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    @if (!tieneMembresia)
    {
        <div class="info-card text-center">

            <div class="mb-4">

                <i class="bi bi-person-badge display-4 text-muted"></i>

            </div>

            <h3 class="mb-3">
                Todavía no tienes una membresía
            </h3>

            <p class="text-muted mb-4">
                Para reservar clases y disfrutar de los beneficios de Jéna,
                primero debes adquirir uno de nuestros planes.
            </p>

            @if (planesDisponibles.Any())
            {
                <div class="row justify-content-center">

                    @foreach (var plan in planesDisponibles)
                    {
                        <div class="col-md-5 mb-3">

                            <div class="border rounded-4 p-4 h-100">

                                <h4 class="fw-bold">
                                    @plan.nombrePlan
                                </h4>

                                <p class="text-muted">

                                    Plan de @plan.duracionDias días con

                                    @if (plan.cantidadClases.HasValue)
                                    {
                                        <span>
                                            @plan.cantidadClases.Value clases disponibles.
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            clases ilimitadas.
                                        </span>
                                    }

                                </p>

                                <h3 class="info-value">
                                    ₡@plan.precio.ToString("N2")
                                </h3>

                                <a href="@Url.Action(
                                             "ConfirmarCompra",
                                             "Clientes",
                                             new
                                             {
                                                 idPlan =
                                                     plan.idPlanMembresia
                                             })"
                                   class="btn btn-action mt-3">

                                    <i class="bi bi-cart-plus me-1"></i>
                                    Comprar plan

                                </a>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">

                    <i class="bi bi-info-circle me-1"></i>

                    En este momento no hay planes disponibles para comprar.

                </div>
            }

        </div>
    }
    else
    {
        <div class="info-card">

            <div class="row align-items-center">

                <div class="col-lg-8 mb-4 mb-lg-0">

                    <div class="d-flex align-items-center gap-2 mb-3">

                        @if (Model.membresiaActual.estadoMembresia == "Activa")
                        {
                            <span class="badge bg-success fs-6">

                                <i class="bi bi-check-circle me-1"></i>
                                Activa

                            </span>
                        }
                        else if (Model.membresiaActual.estadoMembresia == "Vencida")
                        {
                            <span class="badge bg-danger fs-6">

                                <i class="bi bi-x-circle me-1"></i>
                                Vencida

                            </span>
                        }
                        else if (Model.membresiaActual.estadoMembresia == "Suspendida")
                        {
                            <span class="badge bg-warning text-dark fs-6">

                                <i class="bi bi-pause-circle me-1"></i>
                                Suspendida

                            </span>
                        }
                        else if (Model.membresiaActual.estadoMembresia == "Inactiva")
                        {
                            <span class="badge bg-secondary fs-6">

                                <i class="bi bi-dash-circle me-1"></i>
                                Inactiva

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-dark fs-6">

                                @Model.membresiaActual.estadoMembresia

                            </span>
                        }

                    </div>

                    <h2 class="info-value mb-3">
                        @Model.membresiaActual.nombrePlan
                    </h2>

                    @if (planActual != null)
                    {
                        <p class="text-muted">

                            Tu plan tiene una duración de
                            @planActual.duracionDias días e incluye

                            @if (planActual.cantidadClases.HasValue)
                            {
                                <span>
                                    @planActual.cantidadClases.Value clases.
                                </span>
                            }
                            else
                            {
                                <span>
                                    clases ilimitadas.
                                </span>
                            }

                        </p>
                    }
                    else if (esRoot)
                    {
                        <p class="text-muted">
                            Tu plan ROOT incluye clases para utilizar durante
                            su periodo de vigencia.
                        </p>
                    }
                    else if (esTop)
                    {
                        <p class="text-muted">
                            Tu plan TOP permite reservar clases de forma
                            ilimitada durante su periodo de vigencia.
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">
                            Información correspondiente a tu plan de membresía.
                        </p>
                    }

                    <div class="row mt-4">

                        <div class="col-md-6 mb-3">

                            <label class="fw-bold text-muted">
                                Fecha de inicio
                            </label>

                            <div class="fs-5">

                                <i class="bi bi-calendar-check me-1"></i>

                                @(Model.membresiaActual.fechaInicio.ToString("dd/MM/yyyy"))

                            </div>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="fw-bold text-muted">
                                Fecha de vencimiento
                            </label>

                            <div class="fs-5">

                                <i class="bi bi-calendar-x me-1"></i>

                                @(Model.membresiaActual.fechaFin.ToString("dd/MM/yyyy"))

                            </div>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="fw-bold text-muted">
                                Precio del plan
                            </label>

                            <div class="fs-5">
                                ₡@Model.membresiaActual.precio.ToString("N2")
                            </div>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="fw-bold text-muted">
                                Clases disponibles
                            </label>

                            <div class="fs-5">

                                @if (Model.membresiaActual
                                          .clasesDisponibles
                                          .HasValue)
                                {
                                    <i class="bi bi-ticket-perforated me-1"></i>

                                    <span>
                                        @Model.membresiaActual.clasesDisponibles.Value

                                        @if (planActual != null &&
                                             planActual.cantidadClases.HasValue)
                                        {
                                            <text>
                                                de @planActual.cantidadClases.Value
                                            </text>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <i class="bi bi-infinity me-1"></i>

                                    <span>
                                        Ilimitadas
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                    @if (!String.IsNullOrWhiteSpace(
                        Model.membresiaActual.observaciones))
                    {
                        <div class="mt-3">

                            <label class="fw-bold text-muted">
                                Observaciones
                            </label>

                            <div class="border rounded p-3 bg-light mt-1">

                                @Model.membresiaActual.observaciones

                            </div>

                        </div>
                    }

                </div>

                <div class="col-lg-4">

                    <div class="border rounded-4 p-4 text-center bg-light">

                        @if (esVigente)
                        {
                            <i class="bi bi-shield-check display-4 text-success"></i>

                            <h4 class="mt-3">
                                Membresía vigente
                            </h4>

                            <p class="text-muted">
                                Puedes reservar clases mientras tu membresía
                                se encuentre activa y tenga disponibilidad.
                            </p>

                            <a href="@Url.Action(
                                         "ObtenerTodasLasClases",
                                         "Clases")"
                               class="btn btn-action w-100 mb-2">

                                <i class="bi bi-calendar-plus me-1"></i>
                                Reservar clases

                            </a>

                            if (Model.membresiaActual.fechaFin.Date > hoy)
                            {
                                <button type="button"
                                     class="btn btn-outline-secondary w-100"
                                     disabled>

                                      <i class="bi bi-clock me-1"></i>

                                    Renovación disponible el
                                    @(Model.membresiaActual.fechaFin.ToString("dd/MM/yyyy"))

                                </button>
                            }
                            else
                            {
                                <a href="#planesDisponibles"
                                   class="btn btn-outline-success w-100">

                                    <i class="bi bi-arrow-clockwise me-1"></i>
                                    Renovar o cambiar plan

                                </a>
                            }
                        }
                        else if (puedeRenovarOCambiar)
                        {
                            <i class="bi bi-exclamation-circle display-4 text-danger"></i>

                            <h4 class="mt-3">
                                Periodo finalizado
                            </h4>

                            <p class="text-muted">
                                Ya puedes renovar tu plan actual o seleccionar
                                otro plan para el siguiente periodo.
                            </p>

                            <a href="#planesDisponibles"
                               class="btn btn-action w-100">

                                <i class="bi bi-arrow-clockwise me-1"></i>
                                Renovar o cambiar plan

                            </a>
                        }
                        else
                        {
                            <i class="bi bi-info-circle display-4 text-warning"></i>

                            <h4 class="mt-3">
                                Membresía no disponible
                            </h4>

                            <p class="text-muted">

                                Tu membresía se encuentra

                                @Model.membresiaActual
                                .estadoMembresia
                                .ToLower().

                                Comunícate con la administración para obtener
                                más información.

                            </p>
                        }

                    </div>

                </div>

            </div>

        </div>

        <div id="planesDisponibles"
             class="info-card mt-4">

            <div class="text-center mb-4">

                <h3>
                    Planes Jéna
                </h3>

                <p class="text-muted">
                    Podrás renovar o cambiar de plan el día del vencimiento
                    de tu membresía o después.
                </p>

            </div>

            @if (planesDisponibles.Any())
            {
                <div class="row justify-content-center">

                    @foreach (var plan in planesDisponibles)
                    {
                        bool esPlanActual =
                            plan.idPlanMembresia ==
                            Model.membresiaActual.idPlanMembresia;

                        <div class="col-md-5 mb-3">

                            <div class="border rounded-4 p-4 h-100">

                                <h4 class="fw-bold">
                                    @plan.nombrePlan
                                </h4>

                                <p class="text-muted">

                                    @if (plan.cantidadClases.HasValue)
                                    {
                                        <span>
                                            @plan.cantidadClases.Value clases
                                            disponibles durante
                                            @plan.duracionDias días.
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Clases ilimitadas durante
                                            @plan.duracionDias días.
                                        </span>
                                    }

                                </p>

                                <h3 class="info-value">
                                    ₡@plan.precio.ToString("N2")
                                </h3>

                                @if (esPlanActual && esVigente)
                                {
                                    <button type="button"
                                            class="btn btn-outline-secondary w-100"
                                            disabled>

                                        <i class="bi bi-check-circle me-1"></i>
                                        Plan actual

                                    </button>
                                }
                                else if (!puedeRenovarOCambiar)
                                {
                                    <button type="button"
                                            class="btn btn-outline-secondary w-100"
                                            disabled>

                                        <i class="bi bi-clock me-1"></i>
                                        Disponible al vencer tu membresía

                                    </button>
                                }
                                else
                                {
                                    <a href="@Url.Action(
                                                 "ConfirmarCompra",
                                                 "Clientes",
                                                 new
                                                 {
                                                     idPlan =
                                                         plan.idPlanMembresia
                                                 })"
                                       class="btn btn-outline-gym w-100">

                                        @if (esPlanActual)
                                        {
                                            <i class="bi bi-arrow-clockwise me-1"></i>

                                            <text>
                                                Renovar plan
                                            </text>
                                        }
                                        else
                                        {
                                            <i class="bi bi-arrow-left-right me-1"></i>

                                            <text>
                                                Seleccionar plan
                                            </text>
                                        }

                                    </a>
                                }

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-info text-center mb-0">

                    <i class="bi bi-info-circle me-1"></i>

                    En este momento no hay planes disponibles.

                </div>
            }

        </div>
    }

</div>