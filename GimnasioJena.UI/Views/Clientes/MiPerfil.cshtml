@model GimnasioJena.Abstracciones.Modelos.Usuarios.UsuarioPerfilDto

@{
    ViewBag.Title = "MiPerfil";
}

<div class="container-fluid p-4 page-mi-perfil">

    @* Solo visible en mobile *@
    <div class="welcome-section">
        @if (!string.IsNullOrWhiteSpace(Model.fotoPerfil))
        {
            <img src="@Url.Content(Model.fotoPerfil)"
                 class="profile-avatar mx-auto img-cover" />
        }
        else
        {
            <div class="profile-avatar mx-auto">
                <span class="initials">
                    @Model.nombre.Substring(0, 1)@Model.apellido1.Substring(0, 1)
                </span>
                <div class="verified-badge">
                    <i class="bi bi-check-lg"></i>
                </div>
            </div>
        }
        <h1 class="page-title mt-3">Mi Perfil</h1>
    </div>

    @* Solo visible en desktop *@
    <div class="text-center mb-5 desktop-page-title">
        <h1 class="page-title">Mi Perfil</h1>
    </div>

    <div class="stats-grid">

        <div class="stat-card">
            <i class="bi bi-person-check"></i>

            <h2>
                @(Model.estado ? "Activo" : "Inactivo")
            </h2>

            <p>Estado del Perfil</p>
        </div>

        <div class="stat-card">
            <i class="bi bi-credit-card"></i>

            <h2>
                @if (Model.Membresia != null)
                {
                    @Model.Membresia.estadoMembresia
                }
                else
                {
                    @:Sin plan
                }
            </h2>

            <p>Estado de Membresía</p>
        </div>

        <div class="stat-card">
            <i class="bi bi-star-fill"></i>

            <h2>
                @if (Model.Membresia != null)
                {
                    if (!string.IsNullOrWhiteSpace(Model.Membresia.nombrePlan) &&
                        Model.Membresia.nombrePlan.ToUpper().Contains("ROOT"))
                    {
                        @:ROOT
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.Membresia.nombrePlan) &&
                             Model.Membresia.nombrePlan.ToUpper().Contains("TOP"))
                    {
                        @:TOP
                    }
                    else
                    {
                        @Model.Membresia.nombrePlan
                    }
                }
                else
                {
                    @:Ninguna
                }
            </h2>

            <p>Plan Actual</p>
        </div>

    </div>

    <div class="row">
        <div class="col-lg-7 mb-4">
            <div class="info-card">
                <div class="row">
                    <div class="col-md-4 profile-section mb-3 mb-md-0">
                        @if (!string.IsNullOrWhiteSpace(Model.fotoPerfil))
                        {
                            <img src="@Url.Content(Model.fotoPerfil)"
                                 class="profile-avatar mx-auto img-cover" />
                        }
                        else
                        {
                            <div class="profile-avatar mx-auto">
                                <span class="initials">
                                    @Model.nombre.Substring(0, 1)@Model.apellido1.Substring(0, 1)
                                </span>
                                <div class="verified-badge">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-md-8">
                        <div class="info-item">
                            <i class="bi bi-person-circle"></i>
                            <div class="info-content">
                                <div class="info-label">Nombre Completo</div>
                                <div class="info-value">@Model.nombre @Model.apellido1 @Model.apellido2</div>
                            </div>
                        </div>

                        <div class="info-item">
                            <i class="bi bi-envelope"></i>
                            <div class="info-content">
                                <div class="info-label">Correo Electrónico</div>
                                <div class="info-value">@Model.correo</div>
                            </div>
                        </div>

                        <div class="info-item">
                            <i class="bi bi-telephone"></i>
                            <div class="info-content">
                                <div class="info-label">Teléfono</div>
                                <div class="info-value">@Model.telefono</div>
                            </div>
                        </div>

                        <div class="info-item">
                            <i class="bi bi-geo-alt"></i>
                            <div class="info-content">
                                <div class="info-label">Dirección</div>
                                <div class="info-value">
                                    @(string.IsNullOrWhiteSpace(Model.direccion) ? "Sin dirección registrada" : Model.direccion)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="description-card">
                <h2><i class="bi bi-info-circle me-2"></i>Sobre Mí</h2>
                <p>
                    Apasionado por el fitness y el bienestar. Disfruto ayudando a otros a alcanzar sus metas.
                    Me especializo en entrenamiento de fuerza y resistencia. Creo firmemente que la constancia
                    y la disciplina son las claves del éxito en cualquier objetivo físico.
                </p>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="action-buttons-card">
                <h2><i class="bi bi-lightning-charge me-2"></i>Acciones Rápidas</h2>

                <a href="@Url.Action("MiMembresia", "Clientes")" class="btn btn-action">
                    <i class="bi bi-credit-card"></i>
                    <span>Mi Membresía</span>
                </a>

                <a href="@Url.Action("ObtenerTodasLasClases", "Clases")" class="btn btn-action">
                    <i class="bi bi-calendar-plus"></i>
                    <span>Reservar Clase</span>
                </a>

                <a href="@Url.Action("MisReservas", "Clientes")" class="btn btn-action">
                    <i class="bi bi-list-check"></i>
                    <span>Mis Reservas</span>
                </a>

                <a href="@Url.Action("EditarPerfil", "Manage")" class="btn btn-action">
                    <i class="bi bi-pencil-square"></i>
                    <span>Editar Perfil</span>
                </a>
            </div>
        </div>
    </div>
</div>