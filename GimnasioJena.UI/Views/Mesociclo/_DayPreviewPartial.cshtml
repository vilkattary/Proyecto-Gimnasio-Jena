@model GimnasioJena.Abstracciones.Modelos.Entrenamientos.PlantillaDiaDto

@{
    string[] nombresDias =
    {
        "", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"
    };

    string nombreDia = Model.DiaSemana >= 1 && Model.DiaSemana <= 7
        ? nombresDias[Model.DiaSemana]
        : "Día";

    Func<int, string> nombreMetrica = tipo =>
    {
        switch (tipo)
        {
            case 2: return "Tiempo";
            case 3: return "Distancia";
            default: return "Repeticiones";
        }
    };
}

<div class="workout-preview">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <span class="badge bg-dark">@nombreDia</span>
        @if (!string.IsNullOrWhiteSpace(Model.AreaEnfoque))
        {
            <span class="badge bg-secondary">@Model.AreaEnfoque</span>
        }
    </div>

    @if (Model.Ejercicios == null || !Model.Ejercicios.Any())
    {
        <p class="text-muted mb-0">Esta plantilla aún no tiene ejercicios configurados.</p>
    }
    else
    {
        foreach (var ejercicio in Model.Ejercicios.OrderBy(e => e.OrdenIndice))
        {
            <div class="border rounded p-3 mb-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <strong>@ejercicio.NombreEjercicio</strong>
                    <span class="badge bg-light text-dark">@nombreMetrica(ejercicio.TipoMetrica)</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(ejercicio.Notas))
                {
                    <p class="text-muted small mb-2">@ejercicio.Notas</p>
                }

                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0" role="table">
                        <thead>
                            <tr>
                                <th scope="col">Semana</th>
                                <th scope="col">Series</th>
                                @if (ejercicio.TipoMetrica == 2)
                                {
                                    <th scope="col">Duración (seg)</th>
                                }
                                else
                                {
                                    <th scope="col">Repeticiones</th>
                                }
                                <th scope="col">Carga / RPE</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var progresion in ejercicio.Progresiones.OrderBy(p => p.NumeroSemana))
                            {
                                <tr>
                                    <th scope="row">Semana @progresion.NumeroSemana</th>
                                    <td>@progresion.Series</td>
                                    @if (ejercicio.TipoMetrica == 2)
                                    {
                                        <td>@progresion.DuracionSegundos</td>
                                    }
                                    else
                                    {
                                        <td>@progresion.RepeticionesObjetivo</td>
                                    }
                                    <td>@progresion.CargaOrpeSugerido</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>
