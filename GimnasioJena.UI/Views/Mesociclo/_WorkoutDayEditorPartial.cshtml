@model GimnasioJena.Abstracciones.Modelos.Entrenamientos.PlantillaDiaDto

@{
    string[] nombresDias =
    {
        "", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"
    };
}

<div id="workoutEditorRoot"
     data-id-plantilla="@Model.idPlantillaDia"
     data-id-mesociclo="@Model.idMesociclo"
     data-dia-semana="@Model.DiaSemana">

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="info-label" for="wkDiaSemana">Día de la semana</label>
            <select id="wkDiaSemana" class="form-control mt-1">
                @for (byte dia = 1; dia <= 7; dia++)
                {
                    if (dia == Model.DiaSemana)
                    {
                        <option value="@dia" selected="selected">@nombresDias[dia]</option>
                    }
                    else
                    {
                        <option value="@dia">@nombresDias[dia]</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="info-label" for="wkAreaEnfoque">Área de enfoque</label>
            <input id="wkAreaEnfoque" type="text" class="form-control mt-1"
                   value="@Model.AreaEnfoque" placeholder="Ej. Fuerza tren superior" />
        </div>
    </div>

    <div id="wkEjerciciosContenedor"></div>

    <button type="button" id="wkAgregarEjercicio" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-plus-circle me-1"></i> Agregar ejercicio
    </button>

    <div class="d-flex justify-content-end">
        <button type="button" id="wkGuardarPlantilla" class="btn-orange btn-pill-lg">
            <i class="bi bi-check-circle-fill me-2"></i> Guardar rutina
        </button>
    </div>

    <div id="wkMensaje" class="mt-3" role="alert" aria-live="polite"></div>
</div>

<script type="application/json" id="wkDatosIniciales">
    @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Ejercicios))
</script>
