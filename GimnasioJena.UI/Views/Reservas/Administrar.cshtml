@model IEnumerable<GimnasioJena.Abstracciones.Modelos.Reservas.ReservaListadoDto>

@{
    ViewBag.Title = "Administrar Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <a href="javascript:history.back()" class="btn btn-volver" aria-label="Volver">
        <i class="bi bi-arrow-left"></i> Atrás
    </a>
    <div class="mb-5">
        <h1 class="page-title">Administrar Reservas</h1>
        <p class="text-muted">Listado general de reservas registradas en el sistema.</p>
    </div>

    <div class="info-card">
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                No hay reservas registradas.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-jena">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Cliente</th>
                            <th>Clase</th>
                            <th>Entrenador</th>
                            <th>Fecha Clase</th>
                            <th>Horario</th>
                            <th>Estado</th>
                            <th>Fecha Reserva</th>
                        </tr>
                    </thead>
                    <tbody id="cuerpoTablaReservas">
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.idReserva</td>
                                <td>@r.nombreCliente</td>
                                <td>@r.nombreClase</td>
                                <td>@r.nombreEntrenador</td>
                                <td>@r.fechaClase.ToString("dd/MM/yyyy")</td>
                                <td>@r.horaInicio.ToString(@"hh\:mm") - @r.horaFin.ToString(@"hh\:mm")</td>
                                <td>
                                    @if (r.idEstadoReserva == 1)
                                    {
                                        <span class="badge bg-success">@r.estadoReserva</span>
                                    }
                                    else if (r.idEstadoReserva == 2)
                                    {
                                        <span class="badge bg-secondary">@r.estadoReserva</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@r.estadoReserva</span>
                                    }
                                </td>
                                <td>@r.fechaReserva.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="paginacion-info" id="paginacionInfoReservas"></p>
            <div id="paginacion-mobile-reservas" class="paginacion-mobile-wrapper"></div>
        }
    </div>
</div>

@section Scripts {
<script>
    /* ── Paginación mobile – Reservas ───────────────────────── */
    (function () {
        var POR_PAGINA = 5;
        var paginaActual = 1;

        function esMobile() { return window.innerWidth < 768; }

        function filas() {
            return Array.from(document.querySelectorAll('#cuerpoTablaReservas tr'));
        }

        function renderPaginacion(totalPaginas) {
            var container = document.getElementById('paginacion-mobile-reservas');
            var info      = document.getElementById('paginacionInfoReservas');
            if (!container) return;

            if (!esMobile() || totalPaginas <= 1) {
                container.style.display = 'none';
                if (info) info.style.display = 'none';
                return;
            }

            if (info) {
                var desde = (paginaActual - 1) * POR_PAGINA + 1;
                var hasta = Math.min(paginaActual * POR_PAGINA, filas().length);
                info.textContent = 'Mostrando ' + desde + '–' + hasta + ' de ' + filas().length + ' reservas';
                info.style.display = 'block';
            }

            var html = '<ul class="pagination-jena">';

            html += '<li class="page-jena-item' + (paginaActual === 1 ? ' disabled' : '') + '">'
                  + '<button class="page-jena-btn" data-p="' + (paginaActual - 1) + '" aria-label="Anterior">'
                  + '<i class="bi bi-chevron-left"></i></button></li>';

            for (var i = 1; i <= totalPaginas; i++) {
                html += '<li class="page-jena-item' + (i === paginaActual ? ' active' : '') + '">'
                      + '<button class="page-jena-btn" data-p="' + i + '">' + i + '</button></li>';
            }

            html += '<li class="page-jena-item' + (paginaActual === totalPaginas ? ' disabled' : '') + '">'
                  + '<button class="page-jena-btn" data-p="' + (paginaActual + 1) + '" aria-label="Siguiente">'
                  + '<i class="bi bi-chevron-right"></i></button></li>';

            html += '</ul>';
            container.innerHTML = html;
            container.style.display = 'flex';

            container.querySelectorAll('.page-jena-btn[data-p]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    irAPagina(parseInt(this.getAttribute('data-p')));
                });
            });
        }

        function irAPagina(p) {
            var total = Math.ceil(filas().length / POR_PAGINA);
            if (p < 1 || p > total) return;
            paginaActual = p;
            aplicar();
        }

        function aplicar() {
            var rows  = filas();
            var total = Math.ceil(rows.length / POR_PAGINA);

            if (!esMobile()) {
                rows.forEach(function (r) { r.style.display = ''; });
                var c = document.getElementById('paginacion-mobile-reservas');
                var i = document.getElementById('paginacionInfoReservas');
                if (c) c.style.display = 'none';
                if (i) i.style.display = 'none';
                return;
            }

            var desde = (paginaActual - 1) * POR_PAGINA;
            var hasta = desde + POR_PAGINA;
            rows.forEach(function (r, idx) {
                r.style.display = (idx >= desde && idx < hasta) ? '' : 'none';
            });
            renderPaginacion(total);
        }

        aplicar();

        var resizeTimer;
        window.addEventListener('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                paginaActual = 1;
                aplicar();
            }, 150);
        });
    }());
</script>
}
