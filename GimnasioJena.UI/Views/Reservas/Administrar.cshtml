@model IEnumerable<GimnasioJena.Abstracciones.Modelos.Reservas.ReservaListadoDto>

@{
    ViewBag.Title = "Administrar Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="mb-5">
        <h1 class="page-title">Administrar Reservas</h1>
        <p class="text-muted">Listado general de reservas registradas en el sistema.</p>
    </div>

    <div class="info-card">
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                No hay reservas registradas.
            </div>
        }
        else
        {
            <!-- FILTROS -->
            <div class="row g-2 mb-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Cliente</label>
                    <select id="filterCliente" class="form-select">
                        <option value="">Todos</option>
                        @{
                            var clientes = Model.Select(x => x.nombreCliente ?? "").Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s);
                            foreach (var c in clientes)
                            {
                                <option value="@c">@c</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select id="filterEstado" class="form-select">
                        <option value="">Todos</option>
                        @{
                            var estados = Model.Select(x => x.estadoReserva ?? "").Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s);
                            foreach (var e in estados)
                            {
                                <option value="@e">@e</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha clase (desde / hasta)</label>

                    <!-- Fechas -->
                    <div class="d-flex gap-2 mb-2">
                        <input id="filterFechaDesde" type="date" class="form-control" />
                        <input id="filterFechaHasta" type="date" class="form-control" />
                    </div>
                </div>
                <!-- Botones -->
                <div class="d-flex justify-content-end gap-2 mt-2">
                    <button id="btnFilterApply" class="btn-orange w-100">
                        Aplicar
                    </button>
                    <button id="btnFilterReset" class="btn-orange w-100">
                        Limpiar
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table-jena">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Cliente</th>
                            <th>Clase</th>
                            <th>Entrenador</th>
                            <th>Fecha Clase</th>
                            <th>Horario</th>
                            <th>Estado</th>
                            <th>Fecha Reserva</th>
                        </tr>
                    </thead>
                    <tbody id="cuerpoTablaReservas">
                        @foreach (var r in Model)
                        {
                            <tr data-cliente="@(r.nombreCliente ?? "")" data-estado="@(r.estadoReserva ?? "")" data-fecha="@r.fechaClase.ToString("yyyy-MM-dd")" data-filtered="false">
                                <td>@r.idReserva</td>
                                <td>@r.nombreCliente</td>
                                <td>@r.nombreClase</td>
                                <td>@r.nombreEntrenador</td>
                                <td>@r.fechaClase.ToString("dd/MM/yyyy")</td>
                                <td>@r.horaInicio.ToString(@"hh\:mm") - @r.horaFin.ToString(@"hh\:mm")</td>
                                <td>
                                    @if (r.idEstadoReserva == 1)
                                    {
                                        <span class="badge bg-success">@r.estadoReserva</span>
                                    }
                                    else if (r.idEstadoReserva == 2)
                                    {
                                        <span class="badge bg-secondary">@r.estadoReserva</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@r.estadoReserva</span>
                                    }
                                </td>
                                <td>@r.fechaReserva.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="paginacion-info" id="paginacionInfoReservas"></p>
            <div id="paginacion-mobile-reservas" class="paginacion-mobile-wrapper"></div>
        }
    </div>
</div>

@section Scripts {
    <script>
        /* ── Paginación + Filtros – Reservas ───────────────────────── */
        (function () {
            var REGISTROS_MOBILE = 5;
            var REGISTROS_DESKTOP = 15;
            var paginaActual = 1;

            function esMobile() { return window.innerWidth < 768; }

            function obtenerRegistrosPorPagina() {
                return esMobile() ? REGISTROS_MOBILE : REGISTROS_DESKTOP;
            }

            // filas consideradas por paginación: solo aquellas que no están filtradas
            function filas() {
                return Array.from(document.querySelectorAll('#cuerpoTablaReservas tr')).filter(function (r) {
                    return r.dataset.filtered !== 'true';
                });
            }

            function renderPaginacion(totalPaginas) {
                var container = document.getElementById('paginacion-mobile-reservas');
                var info = document.getElementById('paginacionInfoReservas');
                if (!container) return;

                if (totalPaginas <= 1) {
                    container.style.display = 'none';
                    if (info) info.style.display = 'none';
                    return;
                }

                if (info) {
                    var porPagina = obtenerRegistrosPorPagina();
                    var desde = (paginaActual - 1) * porPagina + 1;
                    var hasta = Math.min(paginaActual * porPagina, filas().length);
                    info.textContent = 'Mostrando ' + desde + '–' + hasta + ' de ' + filas().length + ' reservas';
                    info.style.display = 'block';
                }

                var html = '<ul class="pagination-jena">';

                html += '<li class="page-jena-item' + (paginaActual === 1 ? ' disabled' : '') + '">'
                    + '<button class="page-jena-btn" data-p="' + (paginaActual - 1) + '" aria-label="Anterior">'
                    + '<i class="bi bi-chevron-left"></i></button></li>';

                for (var i = 1; i <= totalPaginas; i++) {
                    html += '<li class="page-jena-item' + (i === paginaActual ? ' active' : '') + '">'
                        + '<button class="page-jena-btn" data-p="' + i + '">' + i + '</button></li>';
                }

                html += '<li class="page-jena-item' + (paginaActual === totalPaginas ? ' disabled' : '') + '">'
                    + '<button class="page-jena-btn" data-p="' + (paginaActual + 1) + '" aria-label="Siguiente">'
                    + '<i class="bi bi-chevron-right"></i></button></li>';

                html += '</ul>';
                container.innerHTML = html;
                container.style.display = 'flex';

                container.querySelectorAll('.page-jena-btn[data-p]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        irAPagina(parseInt(this.getAttribute('data-p')));
                    });
                });
            }

            function irAPagina(p) {
                var total = Math.ceil(filas().length / obtenerRegistrosPorPagina()) || 1;
                if (p < 1 || p > total) return;
                paginaActual = p;
                aplicar();
            }

            function aplicar() {
                var allRows = Array.from(document.querySelectorAll('#cuerpoTablaReservas tr'));
                var visibleRows = filas();
                var porPagina = obtenerRegistrosPorPagina();
                var total = Math.ceil(visibleRows.length / porPagina) || 1;

                // Evitar que la página actual quede fuera del rango.
                if (paginaActual > total) {
                    paginaActual = total;
                }

                var desde = (paginaActual - 1) * porPagina;
                var hasta = desde + porPagina;

                // Ocultar todas las filas inicialmente.
                allRows.forEach(function (r) {
                    r.style.display = 'none';
                });

                // Mostrar únicamente los registros de la página actual.
                visibleRows.forEach(function (r, idx) {
                    if (idx >= desde && idx < hasta) {
                        r.style.display = '';
                    }
                });

                renderPaginacion(total);
            }

            /* ── Filtrado ───────────────────────── */
            function aplicarFiltros() {
                var cliente = document.getElementById('filterCliente').value;
                var estado = document.getElementById('filterEstado').value;
                var desdeVal = document.getElementById('filterFechaDesde').value;
                var hastaVal = document.getElementById('filterFechaHasta').value;

                var rows = Array.from(document.querySelectorAll('#cuerpoTablaReservas tr'));
                rows.forEach(function (r) {
                    var rc = (r.dataset.cliente || '').trim();
                    var re = (r.dataset.estado || '').trim();
                    var rf = r.dataset.fecha ? r.dataset.fecha.substring(0, 10) : '';

                    var ocultar = false;

                    if (cliente && rc !== cliente) ocultar = true;
                    if (estado && re !== estado) ocultar = true;
                    if (desdeVal && (!rf || rf < desdeVal)) ocultar = true;
                    if (hastaVal && (!rf || rf > hastaVal)) ocultar = true;

                    r.dataset.filtered = ocultar ? 'true' : 'false';
                    r.style.display = ocultar ? 'none' : '';
                });

                paginaActual = 1;
                aplicar();
            }

            function limpiarFiltros() {
                document.getElementById('filterCliente').value = '';
                document.getElementById('filterEstado').value = '';
                document.getElementById('filterFechaDesde').value = '';
                document.getElementById('filterFechaHasta').value = '';

                var rows = Array.from(document.querySelectorAll('#cuerpoTablaReservas tr'));
                rows.forEach(function (r) {
                    r.dataset.filtered = 'false';
                    r.style.display = '';
                });

                paginaActual = 1;
                aplicar();
            }

            // enlazar eventos
            var btnApply = document.getElementById('btnFilterApply');
            var btnReset = document.getElementById('btnFilterReset');

            if (btnApply) {
                btnApply.addEventListener('click', function (e) {
                    e.preventDefault();
                    aplicarFiltros();
                });
            }

            if (btnReset) {
                btnReset.addEventListener('click', function (e) {
                    e.preventDefault();
                    limpiarFiltros();
                });
            }

            aplicar();

            var resizeTimer;
            window.addEventListener('resize', function () {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(function () {
                    paginaActual = 1;
                    aplicar();
                }, 150);
            });
        }());
    </script>
}
