@model GimnasioJena.Abstracciones.Modelos.Membresias.EditarPrecioPlanDto

@{
    ViewBag.Title = "Editar precio";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h3 class="mb-0">
                        Editar precio de membresía
                    </h3>
                </div>

                <div class="card-body">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(m => m.idPlanMembresia)

                        <div class="mb-3">
                            <label class="form-label">
                                Plan
                            </label>

                            @Html.TextBoxFor(
                                m => m.nombrePlan,
                                new
                                {
                                    @class = "form-control",
                                    @readonly = "readonly"
                                })
                        </div>

                        <div class="mb-4">
                            <label class="form-label">
                                Precio
                            </label>

                            @Html.TextBoxFor(
                                m => m.precio,
                                new
                                {
                                    @class = "form-control",
                                    type = "number",
                                    step = "0.01",
                                    min = "1"
                                })

                            @Html.ValidationMessageFor(
                                m => m.precio,
                                "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-between">

                            <a href="@Url.Action("PlanesMembresia")"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Guardar cambios
                            </button>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")
}