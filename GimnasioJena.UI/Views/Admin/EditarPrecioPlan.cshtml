@model GimnasioJena.Abstracciones.Modelos.Membresias.EditarPrecioPlanDto

@{
    ViewBag.Title = "Editar Precio del Plan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="dashboard-modules py-5">
    <div class="container-jena">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div>
                <h1 class="section-title-admin mb-1">Editar Precio del Plan</h1>
                <p class="admin-card-desc mb-0">Actualiza el precio de la membresía seleccionada.</p>
            </div>
            <a href="@Url.Action("PlanesMembresia", "Admin")" class="btn btn-jena-outline">
                <i class="bi bi-arrow-left me-1"></i>Volver a planes
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5">
                <div class="admin-card">

                    <div class="admin-card-icon">
                        <i class="bi bi-pencil-square"></i>
                    </div>

                    <h2 class="admin-card-title">@Model.nombrePlan</h2>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.idPlanMembresia)

                        <div class="form-group-jena">
                            <label class="form-label-jena" for="nombrePlan">Plan</label>
                            @Html.TextBoxFor(
                                m => m.nombrePlan,
                                new
                                {
                                    @class = "form-control-jena",
                                    id = "nombrePlan",
                                    @readonly = "readonly"
                                })
                        </div>

                        <div class="form-group-jena">
                            <label class="form-label-jena" for="precio">Nuevo precio (&#x20A1;)</label>
                            @Html.TextBoxFor(
                                m => m.precio,
                                new
                                {
                                    @class = "form-control-jena",
                                    id = "precio",
                                    type = "number",
                                    step = "0.01",
                                    min = "1"
                                })
                            @Html.ValidationMessageFor(m => m.precio, "", new { @class = "form-error-jena" })
                        </div>

                        <div class="admin-card-actions mt-2">
                            <a href="@Url.Action("PlanesMembresia", "Admin")"
                               class="btn btn-jena-outline">
                                <i class="bi bi-x-circle me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-jena-outline">
                                <i class="bi bi-check-circle me-1"></i>Guardar cambios
                            </button>
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>
</section>

@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")
}