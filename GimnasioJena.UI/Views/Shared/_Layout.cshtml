<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Jéna Training Methodology</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Audiowide&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link href="@(Url.Content("~/Content/estilo/estilo.css"))?v=14" rel="stylesheet" />
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-apex fixed-top" id="mainNavbar">
        
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <img src="@Url.Content("~/Content/imagenes/logo-jena.png")" alt="Jéna Training Methodology" class="navbar-logo" onerror="this.style.display='none';this.nextElementSibling.style.display='inline';" />
                <span class="navbar-brand-fallback" style="display:none;color:var(--jena-orange);font-family:'Audiowide',sans-serif;font-size:1.2rem;">JÉNA</span>
            </a>

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarApex"
                    aria-controls="navbarApex" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarApex">
                <ul class="navbar-nav ms-auto align-items-center gap-2">

                    @if (User.IsInRole("ADMINISTRADOR"))
                    {
                        @* ── ADMINISTRADOR: Dashboard + 3 Dropdowns ── *@
                        <li class="nav-item">
                            @Html.ActionLink("Dashboard", "Dashboard", "Admin",
                                new { area = "" }, new { @class = "nav-link" })
                        </li>

                        @* Dropdown 1: Gestión Operativa *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-calendar3 me-1"></i>Gestión Operativa
                            </a>
                            <ul class="dropdown-menu dropdown-menu-admin">
                                <li>@Html.ActionLink("Programación Semanal", "Index", "HorariosSemanales", new { area = "" }, new { @class = "dropdown-item" })</li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>@Html.ActionLink("Membresías", "Index", "Membresias", new { area = "" }, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Pagos", "Index", "Pagos", new { area = "" }, new { @class = "dropdown-item" })</li>
                            </ul>
                        </li>

                        @* Dropdown 2: Administración *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-people me-1"></i>Administración
                            </a>
                            <ul class="dropdown-menu dropdown-menu-admin">
                                <li>@Html.ActionLink("Usuarios", "Index", "Usuarios", new { area = "" }, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Reservas", "Administrar", "Reservas", new { area = "" }, new { @class = "dropdown-item" })</li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>@Html.ActionLink("Bitácora", "Index", "Bitacoras", new { area = "" }, new { @class = "dropdown-item" })</li>
                            </ul>
                        </li>

                        @* Dropdown 3: Contenido Web *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-layout-text-window me-1"></i>Contenido Web
                            </a>
                            <ul class="dropdown-menu dropdown-menu-admin">
                                <li>@Html.ActionLink("Home Dinámico", "AdminIndex", "Home", new { area = "" }, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Secciones Nosotros", "Index", "SeccionesNosotros", new { area = "" }, new { @class = "dropdown-item" })</li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        @* ── RESTO DE ROLES / PÚBLICO ── *@
                        <li class="nav-item">
                            @Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" })
                        </li>

                        if (Request.IsAuthenticated && !User.IsInRole("ENTRENADOR") && !User.IsInRole("CLIENTE"))
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Clases", "ObtenerTodasLasClases", "Clases", new { area = "" }, new { @class = "nav-link" })
                            </li>
                        }

                        if (User.IsInRole("ENTRENADOR"))
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Entrenador", "Index", "Entrenadores",
                                    new { area = "" }, new { @class = "nav-link" })
                            </li>

                        }

                        if (User.IsInRole("CLIENTE"))
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Cliente", "MiPerfil", "Clientes",
                                    new { area = "" }, new { @class = "nav-link" })
                            </li>

                            <li class="nav-item">
                                @Html.ActionLink("Mi membresia", "MiMembresia", "Clientes",
                                    new { area = "" }, new { @class = "nav-link" })
                            </li>

                            <li class="nav-item">
                                @Html.ActionLink("Reservar Clase", "ObtenerTodasLasClases", "Clases",
                                    new { area = "" }, new { @class = "nav-link" })
                            </li>

                        }

                        if (!User.IsInRole("ENTRENADOR") && !User.IsInRole("CLIENTE"))
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Sobre Nosotros", "Index", "Nosotros", new { area = "" }, new { @class = "nav-link" })
                            </li>
                            if (!Request.IsAuthenticated)
                            {
                                <li class="nav-item">
                                    @Html.ActionLink("Planes", "Planes", "Home", new { area = "" }, new { @class = "nav-link" })
                                </li>
                            }
                            <li class="nav-item">
                                @Html.ActionLink("Contacto", "Contact", "Home", new { area = "" }, new { @class = "nav-link" })
                            </li>
                        }
                    }





                    @if (Request.IsAuthenticated)
                    {
                        var claimsIdentity = User.Identity as System.Security.Claims.ClaimsIdentity;
                        var nombreClaim = claimsIdentity != null ? claimsIdentity.FindFirst("NombreCompleto") : null;
                        var nombreMostrar = (nombreClaim != null && !string.IsNullOrEmpty(nombreClaim.Value))
                            ? nombreClaim.Value
                            : User.Identity.Name;
                        <li class="nav-item">
                            @if (User.IsInRole("CLIENTE") || User.IsInRole("ENTRENADOR"))
                            {
                                <span class="nav-link text-accent">Hola, @nombreMostrar</span>
                            }
                            else
                            {
                                @Html.ActionLink("Hola, " + nombreMostrar, "Index", "Manage",
                                    routeValues: null,
                                    htmlAttributes: new { @class = "nav-link text-accent" })
                            }
                        </li>
                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                            @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-join-now">Cerrar sesión</button>
                            }
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Iniciar sesión", "Login", "Account",
                                routeValues: null,
                                htmlAttributes: new { @class = "nav-link" })
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a href="@Url.Action("Register", "Account")" class="btn btn-join-now">
                                Unirse Ahora
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <div class="footer-logo mb-3">Jéna Training Methodology</div>
                    <p class="mb-3 text-muted-light">
                        Transforma tu cuerpo y tu mente. Únete a nosotros y alcanza tus metas fitness con el mejor equipo y entrenadores.
                    </p>
                    <div class="social-links">
                        <a href="https://www.facebook.com/share/14sRpixoQFA/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer" class="social-icon">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="https://www.instagram.com/jena.tm?igsh=MXY5Z3dmNXg4bmI2Zw==" target="_blank" rel="noopener noreferrer" class="social-icon">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="https://www.youtube.com/%40JenaTrainingMethodology" target="_blank" rel="noopener noreferrer" class="social-icon">
                            <i class="bi bi-youtube"></i>
                        </a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4">
                    <h5>Enlaces Rápidos</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">@Html.ActionLink("Inicio", "Index", "Home")</li>
                        <li class="mb-2">@Html.ActionLink("Sobre Nosotros", "Index", "Nosotros")</li>
                        <li class="mb-2">@Html.ActionLink("Clases", "ObtenerTodasLasClases", "Clases")</li>
                        <li class="mb-2">@Html.ActionLink("Contacto", "Contact", "Home")</li>
                    </ul>
                </div>
                
                        <div class="col-lg-3 col-md-4">
                            <h5>Servicios</h5>
                            <ul class="list-unstyled">
                                
                                <li class="mb-2"><a href="#">@Html.ActionLink("Clases Grupales", "ObtenerTodasLasClases", "Clases")</a></li>
                                
                                <li class="mb-2"><a href="#">@Html.ActionLink("Mi membresia", "MiMembresia", "Clientes") </a></li>
                            </ul>
                        </div>
                        
                        <div class="col-lg-3 col-md-4">
                            <h5>Contacto</h5>
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="bi bi-geo-alt-fill me-2 text-accent"></i>
                                    <a href="https://www.waze.com/live-map/directions?to=ll.10.003374%2C-84.039509"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="text-decoration-none">
                                        Nos ubicamos en San Luis de Santo Domingo, 500 m este de la ferretería Industrias Zurquí.
                                    </a>
                                </li>
                                <li class="mb-2"><i class="bi bi-telephone-fill me-2 text-accent"></i>+506 8619 5885</li>
                                <li class="mb-2"><i class="bi bi-envelope-fill me-2 text-accent"></i>jena.tm@outlook.com</li>
                                <li class="mb-2"><i class="bi bi-clock-fill me-2 text-accent"></i>Lun-Vie: 5AM - 7PM </br> Sabados: 7AM - 10AM</li>
                            </ul>
                        </div>
                    </div>

                    <div class="copyright text-center">
                        <p class="mb-0">&copy; @DateTime.Now.Year Jéna Training Methodology. Todos los derechos reservados.</p>
                    </div>
                </div>
            </footer>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-3.7.1.min.js"></script>

            @RenderSection("scripts", required: false)

            <script>
                (function () {
                    var navbar = document.getElementById('mainNavbar');

                    function onScroll() {
                        if (window.scrollY > 50) {
                            navbar.classList.add('navbar-scrolled');
                        } else {
                            navbar.classList.remove('navbar-scrolled');
                        }
                    }

                    window.addEventListener('scroll', onScroll, { passive: true });
                    onScroll();
                })();
            </script>
        </body>
        </html>
