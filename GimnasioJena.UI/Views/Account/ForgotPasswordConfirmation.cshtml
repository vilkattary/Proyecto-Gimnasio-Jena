@{
    ViewBag.Title = "Correo enviado";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-sm-10 col-md-8 col-lg-5">
            <div class="card-jena-info card-top-accent">
                <div class="card-body p-4">

                    <div class="mb-3">
                        <i class="bi bi-envelope-check-fill text-accent icon-jena-xl"></i>
                    </div>

                    <span class="d-inline-block fst-italic stat-number-jena">
                        <i class="bi bi-lightning-charge-fill me-1"></i>GIMNASIO JENA
                    </span>

                    <h2 class="text-navy">
                        Revisa tu correo electrónico
                    </h2>

                    <p class="text-muted mt-3">
                        Hemos enviado un enlace para restablecer tu contraseña.
                    </p>

                    <p class="small text-muted">
                        Si el correo existe en nuestro sistema, recibirás instrucciones para crear una nueva contraseña.
                    </p>

                    <a href="@Url.Action("Login", "Account")"
                       class="btn btn-action mt-3">
                        Volver al inicio de sesión
                    </a>

                </div>
            </div>
        </div>
    </div>
</section>



