@model GimnasioJena.UI.Models.LoginViewModel

@{
    ViewBag.Title = "Iniciar sesión";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-sm-10 col-md-8 col-lg-5">
            <div class="card-jena-info card-top-accent">
                <div class="card-body p-4">

                    <div class="text-center mb-3">
                        <span class="d-inline-block fst-italic stat-number-jena">
                            <i class="bi bi-lightning-charge-fill me-1"></i>GIMNASIO JENA
                        </span>
                        <h2 class="text-navy">Accede a tu cuenta</h2>
                    </div>

                    @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Email, "Correo electrónico", new { @class = "form-label fw-600" })

                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-accent">
                                    <i class="bi bi-person-fill"></i>
                                </span>

                                @Html.TextBoxFor(m => m.Email, new
                                {
                                    @class = "form-control border-start-0",
                                    type = "email",
                                    placeholder = "tu@correo.com",
                                    required = "required"
                                })
                            </div>

                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Password, "Contraseña", new { @class = "form-label fw-600" })

                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-accent">
                                    <i class="bi bi-lock-fill"></i>
                                </span>

                                @Html.PasswordFor(m => m.Password, new
                                {
                                    @class = "form-control border-start-0",
                                    placeholder = "********",
                                    required = "required"
                                })
                            </div>

                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <div class="form-check d-flex align-items-center gap-2 mb-0 ps-0">
                                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input m-0 flex-shrink-0", style = "width: 1.15rem; height: 1.15rem; min-width: 1.15rem; margin: 0; appearance: auto; -webkit-appearance: auto; float: none;" })
                                @Html.LabelFor(m => m.RememberMe, "Recuérdame", new { @class = "form-check-label small mb-0" })
                            </div>

                            <a href="@Url.Action("ForgotPassword", "Account")"
                               class="small link-accent">
                                ¿Olvidaste la contraseña?
                            </a>
                        </div>

                        <button type="submit" class="btn btn-action w-100 py-2">
                            Entrar
                        </button>

                        <div class="text-center mb-3">
                            <span class="small text-muted">¿No tienes cuenta?</span>
                            <a href="@Url.Action("Register", "Account")" class="btn btn-outline-gym btn-sm ms-2">
                                Regístrate
                            </a>
                        </div>
                    }

                </div>
            </div>

            <p class="text-center text-muted small mt-3">
                Al iniciar sesión aceptas las condiciones del gimnasio.
            </p>
        </div>
    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}



