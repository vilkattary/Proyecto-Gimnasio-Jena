@{
    ViewBag.Title = "Nosotros";
}

<!-- Page Header -->
<section class="hero-section-dark">
    <div class="container text-center">
        <p class="text-uppercase mb-2 eyebrow-jena">
            <i class="bi bi-info-circle-fill me-1"></i> Quiénes somos
        </p>
        <h1 class="text-white">SOBRE <span class="text-accent">NOSOTROS</span></h1>
        <div class="mx-auto divider-orange"></div>
    </div>
</section>

<!-- Mission & Vision -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <p class="text-uppercase mb-1 eyebrow-jena">Nuestra historia</p>
                <h2 class="text-navy">MÁS DE 10 AÑOS FORJANDO CAMPEONES</h2>
                <p class="text-muted mb-3">
                    Gimnasio Jena nació con una misión clara: ofrecer a nuestra comunidad un espacio de entrenamiento de alto rendimiento,
                    accesible para todos. Desde nuestros inicios hemos crecido junto a cientos de miembros que han alcanzado sus metas
                    de salud y bienestar.
                </p>
                <p class="text-muted mb-4">
                    Contamos con instalaciones modernas, equipos de última generación y un equipo de entrenadores certificados
                    comprometidos con tu progreso personal.
                </p>
                <div class="row g-3">
                    <div class="col-4 text-center">
                        <div class="fw-bold stat-number-jena">500+</div>
                        <div class="text-muted small">Miembros activos</div>
                    </div>
                    <div class="col-4 text-center">
                        <div class="fw-bold stat-number-jena">10+</div>
                        <div class="text-muted small">Años de experiencia</div>
                    </div>
                    <div class="col-4 text-center">
                        <div class="fw-bold stat-number-jena">20+</div>
                        <div class="text-muted small">Clases semanales</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <i class="bi bi-lightning-charge-fill icon-hero-ghost"></i>
            </div>
        </div>
    </div>
</section>

<!-- Mission & Vision Cards -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card-jena-info h-100 border-l-accent">
                    <i class="bi bi-bullseye mb-3 icon-jena-xl"></i>
                    <h4 class="heading-dark">NUESTRA MISIÓN</h4>
                    <p class="text-muted mb-0">
                        Proporcionar un ambiente motivador y seguro donde cada persona pueda alcanzar sus objetivos de salud
                        y condición física, con el apoyo de profesionales especializados y equipos de primer nivel.
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card-jena-info h-100 border-l-accent">
                    <i class="bi bi-eye-fill mb-3 icon-jena-xl"></i>
                    <h4 class="heading-dark">NUESTRA VISIÓN</h4>
                    <p class="text-muted mb-0">
                        Ser el gimnasio de referencia en la región, reconocido por la calidad de nuestros servicios,
                        la excelencia de nuestros entrenadores y el impacto positivo en la salud de nuestra comunidad.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Values -->
<section class="py-5 hero-dark-1a">
    <div class="container">
        <div class="text-center mb-5">
            <p class="text-uppercase mb-1 eyebrow-jena">Lo que nos define</p>
            <h2 class="text-white">NUESTROS VALORES</h2>
            <div class="mx-auto mt-2 divider-orange"></div>
        </div>
        <div class="row g-4">
            <div class="col-sm-6 col-lg-3 text-center">
                <div class="p-3">
                    <i class="bi bi-award-fill mb-3 d-block icon-jena-xl"></i>
                    <h5 class="text-white heading-dark">Excelencia</h5>
                    <p class="text-secondary small">Buscamos la mejora continua en cada servicio que ofrecemos a nuestros miembros.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3 text-center">
                <div class="p-3">
                    <i class="bi bi-heart-fill mb-3 d-block icon-jena-xl"></i>
                    <h5 class="text-white heading-dark">Compromiso</h5>
                    <p class="text-secondary small">Estamos dedicados al bienestar y progreso de cada uno de nuestros miembros.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3 text-center">
                <div class="p-3">
                    <i class="bi bi-people-fill mb-3 d-block icon-jena-xl"></i>
                    <h5 class="text-white heading-dark">Comunidad</h5>
                    <p class="text-secondary small">Fomentamos un ambiente inclusivo donde todos se sienten bienvenidos y motivados.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3 text-center">
                <div class="p-3">
                    <i class="bi bi-shield-fill-check mb-3 d-block icon-jena-xl"></i>
                    <h5 class="text-white heading-dark">Integridad</h5>
                    <p class="text-secondary small">Actuamos con honestidad y transparencia en todo lo que hacemos.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-5 bg-accent">
    <div class="container text-center">
        <h2 class="text-white heading-dark">
            ¿QUIERES SER PARTE DE NUESTRA FAMILIA?
        </h2>
        <p class="text-white mb-4 img-hero-opacity">
            Únete a los cientos de miembros que ya confían en Gimnasio Jena para alcanzar sus objetivos.
        </p>
        <a href="@Url.Action("Contact", "Home")" class="btn btn-dark btn-lg px-5 heading-dark">
            <i class="bi bi-person-plus-fill me-2"></i>ÚNETE AHORA
        </a>
    </div>
</section>
