@using GimnasioJena.Abstracciones.Modelos.Membresias
@model List<PlanMembresiaListadoDto>
@{
    ViewBag.Title = "Planes";
}

<section class="py-5">
    <div class="container">
        <!-- Hero -->
        <div class="text-center mb-5 plans-hero">
            <h1 class="heading-jena">Planes y Membresías</h1>
            <p class="lead text-muted">Elige el plan que mejor se adapte a tus objetivos.</p>
        </div>

        <!-- Plan Cards -->
        @if (Model != null && Model.Any())
        {
            <div class="row justify-content-center g-4 mb-5">
                @foreach (var plan in Model)
                {
                    <div class="col-sm-6 col-md-4">
                        <div class="card-jena-info h-100 card-top-accent">
                            <div class="card-body d-flex flex-column">

                                <h4 class="fw-bold">@plan.nombrePlan</h4>

                                <p class="text-muted mb-2">
                                    Plan de @plan.duracionDias días con
                                    @if (plan.cantidadClases.HasValue)
                                    {
                                        <span>@plan.cantidadClases.Value clases disponibles.</span>
                                    }
                                    else
                                    {
                                        <span>clases ilimitadas.</span>
                                    }
                                </p>

                                <h3 class="info-value">₡@plan.precio.ToString("N2")</h3>

                                <div class="mt-auto">
                                    <a class="btn btn-gym w-100 mt-3"
                                       href="@Url.Action("ConfirmarCompra", "Clientes", new { idPlan = plan.idPlanMembresia })">
                                        <i class="bi bi-cart-plus me-1"></i>
                                        Comprar plan
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info text-center mb-5">
                No hay planes disponibles en este momento.
            </div>
        }

    </div>
</section>

