@model IEnumerable<GimnasioJena.Abstracciones.Modelos.Bitacora.BitacoraDto>

@{
    ViewBag.Title = "Bitácora";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="mb-5">
        <h1 class="page-title">Bitácora del Sistema</h1>
        <p class="text-muted">Registro de acciones importantes realizadas dentro del sistema.</p>
    </div>

    <div class="info-card">
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                No hay registros en la bitácora.
            </div>
        }
        else
        {
            <!-- FILTROS -->
            <div class="row g-2 mb-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Usuario</label>
                    <select id="filterUsuario" class="form-select">
                        <option value="">Todos</option>
                        @{
                            var usuarios = Model.Select(x => x.nombreUsuario ?? "").Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s);
                            foreach (var u in usuarios)
                            {
                                <option value="@u">@u</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Acción</label>
                    <select id="filterAccion" class="form-select">
                        <option value="">Todas</option>
                        @{
                            var acciones = Model.Select(x => x.accionRealizada ?? "").Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s);
                            foreach (var a in acciones)
                            {
                                <option value="@a">@a</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-5">
                    <label class="form-label">Fecha (desde / hasta)</label>
                    <div class="d-flex gap-2">
                        <input id="filterFechaDesde" type="date" class="form-control" />
                        <input id="filterFechaHasta" type="date" class="form-control" />
                        <button id="btnFilterApply" class="btn btn-primary">Aplicar</button>
                        <button id="btnFilterReset" class="btn btn-outline-secondary">Limpiar</button>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table-jena table table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Usuario</th>
                            <th>Tabla</th>
                            <th>Acción</th>
                            <th>Registro</th>
                            <th>Fecha</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>
                    <tbody id="cuerpoTablaBitacora">
                        @foreach (var b in Model)
                        {
                            var usuarioSafe = b.nombreUsuario ?? "";
                            var accionSafe = b.accionRealizada ?? "";
                            var fechaIso = b.fechaAccion.ToString("yyyy-MM-ddTHH:mm:ss");
                            <tr data-user="@usuarioSafe" data-action="@accionSafe" data-fecha="@fechaIso" data-filtered="false">
                                <td>@b.idBitacora</td>
                                <td>@usuarioSafe</td>
                                <td>@b.tablaAfectada</td>
                                <td>
                                    @if (b.accionRealizada == "CREAR")
                                    {
                                        <span class="badge bg-success">@b.accionRealizada</span>
                                    }
                                    else if (b.accionRealizada == "EDITAR")
                                    {
                                        <span class="badge bg-primary">@b.accionRealizada</span>
                                    }
                                    else if (b.accionRealizada == "ELIMINAR")
                                    {
                                        <span class="badge bg-danger">@b.accionRealizada</span>
                                    }
                                    else if (b.accionRealizada == "RENOVAR")
                                    {
                                        <span class="badge bg-warning text-dark">@b.accionRealizada</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@b.accionRealizada</span>
                                    }
                                </td>
                                <td>@(b.idRegistroAfectado.HasValue ? b.idRegistroAfectado.Value.ToString() : "-")</td>
                                <td>@b.fechaAccion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@b.detalle</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="paginacion-info" id="paginacionInfoBitacora"></p>
            <div id="paginacion-mobile-bitacora" class="paginacion-mobile-wrapper"></div>
        }
    </div>
</div>

@section Scripts {
<script>
    (function () {
        /* ── Paginación + Filtros mobile – Bitácora ───────────────────────── */
        var POR_PAGINA = 5;
        var paginaActual = 1;

        function esMobile() { return window.innerWidth < 768; }

        // filas consideradas por paginación: solo aquellas que no están filtradas
        function filas() {
            return Array.from(document.querySelectorAll('#cuerpoTablaBitacora tr')).filter(function (r) {
                return r.dataset.filtered !== 'true';
            });
        }

        function renderPaginacion(totalPaginas) {
            var container = document.getElementById('paginacion-mobile-bitacora');
            var info = document.getElementById('paginacionInfoBitacora');
            if (!container) return;

            if (!esMobile() || totalPaginas <= 1) {
                container.style.display = 'none';
                if (info) info.style.display = 'none';
                return;
            }

            if (info) {
                var desde = (paginaActual - 1) * POR_PAGINA + 1;
                var hasta = Math.min(paginaActual * POR_PAGINA, filas().length);
                info.textContent = 'Mostrando ' + desde + '–' + hasta + ' de ' + filas().length + ' registros';
                info.style.display = 'block';
            }

            var html = '<ul class="pagination-jena">';

            html += '<li class="page-jena-item' + (paginaActual === 1 ? ' disabled' : '') + '">'
                + '<button class="page-jena-btn" data-p="' + (paginaActual - 1) + '" aria-label="Anterior">'
                + '<i class="bi bi-chevron-left"></i></button></li>';

            for (var i = 1; i <= totalPaginas; i++) {
                html += '<li class="page-jena-item' + (i === paginaActual ? ' active' : '') + '">'
                    + '<button class="page-jena-btn" data-p="' + i + '">' + i + '</button></li>';
            }

            html += '<li class="page-jena-item' + (paginaActual === totalPaginas ? ' disabled' : '') + '">'
                + '<button class="page-jena-btn" data-p="' + (paginaActual + 1) + '" aria-label="Siguiente">'
                + '<i class="bi bi-chevron-right"></i></button></li>';

            html += '</ul>';
            container.innerHTML = html;
            container.style.display = 'flex';

            container.querySelectorAll('.page-jena-btn[data-p]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    irAPagina(parseInt(this.getAttribute('data-p')));
                });
            });
        }

        function irAPagina(p) {
            var total = Math.ceil(filas().length / POR_PAGINA) || 1;
            if (p < 1 || p > total) return;
            paginaActual = p;
            aplicar();
        }

        function aplicar() {
            var allRows = Array.from(document.querySelectorAll('#cuerpoTablaBitacora tr'));
            var visibleRows = filas();
            var total = Math.ceil(visibleRows.length / POR_PAGINA) || 1;

            if (!esMobile()) {
                // en desktop mostramos todas las filas que no están filtradas
                allRows.forEach(function (r) {
                    if (r.dataset.filtered === 'true') {
                        r.style.display = 'none';
                    } else {
                        r.style.display = '';
                    }
                });
                var c = document.getElementById('paginacion-mobile-bitacora');
                var i = document.getElementById('paginacionInfoBitacora');
                if (c) c.style.display = 'none';
                if (i) i.style.display = 'none';
                return;
            }

            // mobile: paginación sobre filas visibles
            var desde = (paginaActual - 1) * POR_PAGINA;
            var hasta = desde + POR_PAGINA;
            visibleRows.forEach(function (r, idx) {
                r.style.display = (idx >= desde && idx < hasta) ? '' : 'none';
            });

            // asegurarse que filas filtradas sigan ocultas
            allRows.filter(function (r) { return r.dataset.filtered === 'true'; }).forEach(function (r) {
                r.style.display = 'none';
            });

            renderPaginacion(total);
        }

        /* ── Filtrado ───────────────────────── */
        function aplicarFiltros() {
            var usuario = document.getElementById('filterUsuario').value;
            var accion = document.getElementById('filterAccion').value;
            var desdeVal = document.getElementById('filterFechaDesde').value;
            var hastaVal = document.getElementById('filterFechaHasta').value;

            var desdeDate = desdeVal ? new Date(desdeVal + 'T00:00:00') : null;
            var hastaDate = hastaVal ? new Date(hastaVal + 'T23:59:59') : null;

            var rows = Array.from(document.querySelectorAll('#cuerpoTablaBitacora tr'));
            rows.forEach(function (r) {
                var ru = (r.dataset.user || '').trim();
                var ra = (r.dataset.action || '').trim();
                var rf = r.dataset.fecha ? new Date(r.dataset.fecha) : null;

                var ocultar = false;

                if (usuario && ru !== usuario) ocultar = true;
                if (accion && ra !== accion) ocultar = true;
                if (desdeDate && rf && rf < desdeDate) ocultar = true;
                if (hastaDate && rf && rf > hastaDate) ocultar = true;

                r.dataset.filtered = ocultar ? 'true' : 'false';
                if (ocultar) {
                    r.style.display = 'none';
                } else {
                    // dejar que aplicar() controle visibilidad por paginación
                    r.style.display = '';
                }
            });

            paginaActual = 1;
            aplicar();
        }

        function limpiarFiltros() {
            document.getElementById('filterUsuario').value = '';
            document.getElementById('filterAccion').value = '';
            document.getElementById('filterFechaDesde').value = '';
            document.getElementById('filterFechaHasta').value = '';

            var rows = Array.from(document.querySelectorAll('#cuerpoTablaBitacora tr'));
            rows.forEach(function (r) {
                r.dataset.filtered = 'false';
                r.style.display = '';
            });

            paginaActual = 1;
            aplicar();
        }

        // enlazar eventos
        document.getElementById('btnFilterApply').addEventListener('click', function (e) {
            e.preventDefault();
            aplicarFiltros();
        });

        document.getElementById('btnFilterReset').addEventListener('click', function (e) {
            e.preventDefault();
            limpiarFiltros();
        });

        // aplicar comportamiento inicial
        aplicar();

        var resizeTimer;
        window.addEventListener('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                paginaActual = 1;
                aplicar();
            }, 150);
        });
    }());
</script>
}