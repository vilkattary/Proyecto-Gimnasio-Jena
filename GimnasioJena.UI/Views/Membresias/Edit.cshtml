@model GimnasioJena.Abstracciones.Modelos.Membresias.MembresiaEditarDto

@{
    ViewBag.Title = "Editar Membresía";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="page-title">Editar Membresía</h1>
        <p class="text-muted">
            Actualiza el estado, la fecha de inicio o las observaciones de la membresía.
        </p>
    </div>

    <div class="info-card">

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">
                @TempData["MensajeError"]
            </div>
        }

        @using (Html.BeginForm("Edit", "Membresias", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.idMembresiaCliente)
            @Html.HiddenFor(m => m.idUsuario)
            @Html.HiddenFor(m => m.idPlanMembresia)
            @Html.HiddenFor(m => m.fechaFin)
            @Html.HiddenFor(m => m.clasesDisponibles)

            <div class="mb-3">
                <label class="form-label fw-bold">Cliente</label>

                <input type="text"
                       class="form-control"
                       value="@ViewBag.NombreCliente"
                       readonly />

                <small class="text-muted">
                    El cliente asignado a la membresía no puede modificarse.
                </small>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Plan</label>

                <input type="text"
                       class="form-control"
                       value="@ViewBag.NombrePlan"
                       readonly />

                <small class="text-muted">
                    Para cambiar de plan deberá utilizarse posteriormente el proceso de renovación o cambio de membresía.
                </small>
            </div>

            <div class="mb-3">
                @Html.LabelFor(
                    m => m.idEstadoMembresia,
                    "Estado",
                    new { @class = "form-label fw-bold" }
                )

                @Html.DropDownListFor(
                    m => m.idEstadoMembresia,
                    (IEnumerable<SelectListItem>)ViewBag.Estados,
                    "Seleccione un estado",
                    new { @class = "form-select" }
                )

                @Html.ValidationMessageFor(
                    m => m.idEstadoMembresia,
                    "",
                    new { @class = "text-danger" }
                )
            </div>

            <div class="mb-3">
                @Html.LabelFor(
                    m => m.fechaInicio,
                    "Fecha de inicio",
                    new { @class = "form-label fw-bold" }
                )

                @Html.TextBoxFor(
                    m => m.fechaInicio,
                    "{0:yyyy-MM-dd}",
                    new
                    {
                        @class = "form-control",
                        type = "date"
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.fechaInicio,
                    "",
                    new { @class = "text-danger" }
                )

                <small class="text-muted">
                    Al cambiar la fecha de inicio, la fecha de finalización se recalculará automáticamente según la duración del plan.
                </small>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">
                        Fecha de finalización actual
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.fechaFin.ToString("dd/MM/yyyy")"
                           readonly />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">
                        Clases disponibles actuales
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@(Model.clasesDisponibles.HasValue
                               ? Model.clasesDisponibles.Value.ToString()
                               : "Ilimitadas")"
                           readonly />
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(
                    m => m.observaciones,
                    "Observaciones",
                    new { @class = "form-label fw-bold" }
                )

                @Html.TextAreaFor(
                    m => m.observaciones,
                    new
                    {
                        @class = "form-control",
                        rows = "4",
                        placeholder = "Observaciones opcionales..."
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.observaciones,
                    "",
                    new { @class = "text-danger" }
                )
            </div>

            <div class="alert alert-info mt-4">
                <strong>Información:</strong>
                la fecha final será calculada automáticamente según el plan de la membresía.
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-action">
                    Guardar Cambios
                </button>

                <a href="@Url.Action("Index", "Membresias")"
                   class="btn btn-outline-gym">
                    Volver
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}