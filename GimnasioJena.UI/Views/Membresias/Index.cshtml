@model IEnumerable<GimnasioJena.Abstracciones.Modelos.Membresias.MembresiaListadoDto>

@{
    ViewBag.Title = "Membresías";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var membresias = Model ?? Enumerable.Empty<dynamic>();
    var planes = membresias
        .Where(m => !string.IsNullOrWhiteSpace((string)m.nombrePlan))
        .Select(m => (string)m.nombrePlan)
        .Distinct()
        .OrderBy(p => p)
        .ToList();

    var clientes = membresias
        .Where(m => !string.IsNullOrWhiteSpace((string)m.nombreCliente))
        .Select(m => (string)m.nombreCliente)
        .Distinct()
        .OrderBy(c => c)
        .ToList();
}
<div class="container py-5">
    <a href="javascript:history.back()" class="btn btn-volver" aria-label="Volver">
        <i class="bi bi-arrow-left"></i> Atrás
    </a>

    <div class="text-center mb-5">
        <h1 class="page-title">Membresías</h1>
        <p class="text-muted">
            Administración general de las membresías asignadas a los clientes.
        </p>
    </div>

    <div class="d-flex justify-content-end mb-4">
        <a href="@Url.Action("Create", "Membresias")" class="btn btn-action">
            <i class="bi bi-plus-circle me-1"></i>
            Registrar Membresía
        </a>
    </div>

    <!-- FILTROS: Plan | Estado | Cliente -->
    <div class="info-card mb-4">
        <div class="row align-items-end g-3">
            <div class="col-md-4">
                <label class="info-label mb-1">
                    <i class="bi bi-list me-1"></i>
                    Plan
                </label>
                <select class="form-select" id="filtroPlan">
                    <option value="">Todos los planes</option>
                    @foreach (var p in planes)
                    {
                        <option value="@p.ToLower()">@p</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="info-label mb-1">
                    <i class="bi bi-toggle-on me-1"></i>
                    Estado
                </label>
                <select class="form-select" id="filtroEstadoMembresias">
                    <option value="">Todos</option>
                    <option value="activa">Activa</option>
                    <option value="inactiva">Inactiva</option>
                    <option value="vencida">Vencida</option>
                    <option value="suspendida">Suspendida</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="info-label mb-1">
                    <i class="bi bi-person me-1"></i>
                    Cliente
                </label>
                <select class="form-select" id="filtroCliente">
                    <option value="">Todos los clientes</option>
                    @foreach (var c in clientes)
                    {
                        <option value="@c.ToLower()">@c</option>
                    }
                </select>
            </div>

            <div class="col-12 d-md-none mt-2"></div>

            <div class="col-md-3">
                <button type="button" class="btn-orange w-100" onclick="aplicarFiltrosMembresias()">
                    <i class="bi bi-search me-2"></i>
                    Buscar
                </button>
            </div>
            <div class="col-md-3">
                <button type="button" class="btn btn-outline-secondary w-100" onclick="resetearFiltrosMembresias()">
                    <i class="bi bi-x-circle me-2"></i>
                    Limpiar
                </button>
            </div>
        </div>
    </div>

    <div class="info-card">

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">
                @TempData["MensajeExito"]
            </div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">
                @TempData["MensajeError"]
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                No hay membresías registradas.
            </div>
        }
        else
        {


            <div class="table-responsive">
                <table class="table-jena tabla-membresias">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Cliente</th>
                            <th>Plan</th>
                            <th class="col-mobile-oculto">Precio</th>
                            <th>Estado</th>
                            <th class="col-mobile-oculto">Inicio</th>
                            <th class="col-mobile-oculto">Fin</th>
                            <th class="col-mobile-oculto">Clases</th>
                            <th class="text-center col-mobile-oculto">Acciones</th>
                        </tr>
                    </thead>

                    <tbody id="cuerpoTablaMembresias">

                        @foreach (var m in Model)
                        {
                            var planData = (m.nombrePlan ?? "").ToString().ToLower();
                            var estadoData = (m.estadoMembresia ?? "").ToString().ToLower();
                            var clienteData = (m.nombreCliente ?? "").ToString().ToLower();
                            <tr data-plan="@planData" data-estado="@estadoData" data-cliente="@clienteData">
                                <td data-label="#">@m.idMembresiaCliente</td>

                                <td data-label="Cliente">@m.nombreCliente</td>

                                <td data-label="Plan">@m.nombrePlan</td>

                                <td data-label="Precio" class="col-mobile-oculto">
                                    ₡ @m.precio.ToString("N2")
                                </td>

                                <td data-label="Estado">

                                    @if (m.estadoMembresia == "Activa")
                                    {
                                        <span class="badge bg-success">
                                            @m.estadoMembresia
                                        </span>
                                    }
                                    else if (m.estadoMembresia == "Inactiva")
                                    {
                                        <span class="badge bg-secondary">
                                            @m.estadoMembresia
                                        </span>
                                    }
                                    else if (m.estadoMembresia == "Vencida")
                                    {
                                        <span class="badge bg-danger">
                                            @m.estadoMembresia
                                        </span>
                                    }
                                    else if (m.estadoMembresia == "Suspendida")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @m.estadoMembresia
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">
                                            @m.estadoMembresia
                                        </span>
                                    }

                                </td>

                                <td data-label="Inicio" class="col-mobile-oculto">
                                    @m.fechaInicio.ToString("dd/MM/yyyy")
                                </td>

                                <td data-label="Fin" class="col-mobile-oculto">
                                    @m.fechaFin.ToString("dd/MM/yyyy")
                                </td>

                                <td data-label="Clases" class="col-mobile-oculto">

                                    @(m.clasesDisponibles.HasValue
                                        ? m.clasesDisponibles.Value.ToString()
                                        : "Ilimitadas")

                                </td>

                                <td class="text-center col-mobile-oculto">

                                    <a href="@Url.Action(
                 "Details",
                 "Membresias",
                 new { id = m.idMembresiaCliente })"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                        Detalle
                                    </a>

                                    <a href="@Url.Action(
                 "Edit",
                 "Membresias",
                 new { id = m.idMembresiaCliente })"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-square"></i>
                                        Editar
                                    </a>

                                    @if (m.fechaFin.Date <= DateTime.Today)
                                    {
                                        using (Html.BeginForm(
                                            "Renovar",
                                            "Membresias",
                                            FormMethod.Post,
                                            new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@m.idMembresiaCliente" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    onclick="return confirm('¿Deseas renovar esta membresía? Al confirmar, el nuevo periodo iniciará hoy y se restablecerán las clases disponibles según el plan.')">
                                                <i class="bi bi-arrow-clockwise"></i>
                                                Renovar
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled
                                                title="La membresía podrá renovarse el día de su vencimiento">
                                            <i class="bi bi-clock"></i>
                                            Vigente
                                        </button>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            </div>

            <p class="paginacion-info" id="paginacionInfoMembresias"></p>
            <div id="paginacion-mobile-membresias" class="paginacion-mobile-wrapper"></div>
        }
    </div>

</div>

@section Scripts {
<script>
    /* ── Paginación mobile – Membresías + filtros (FIX: aplicar filtro también en desktop) ─────────────────────── */
    (function () {
        var POR_PAGINA = 5;
        var paginaActual = 1;

        function esMobile() { return window.innerWidth < 768; }

        // filas activas (considera filtro por dataset.visible)
        function filas() {
            return Array.from(document.querySelectorAll('#cuerpoTablaMembresias tr'))
                .filter(function (r) { return r.dataset.visible !== '0'; });
        }

        function filasTodas() {
            return Array.from(document.querySelectorAll('#cuerpoTablaMembresias tr'));
        }

        function renderPaginacion(totalPaginas) {
            var container = document.getElementById('paginacion-mobile-membresias');
            var info      = document.getElementById('paginacionInfoMembresias');
            if (!container) return;

            if (!esMobile() || totalPaginas <= 1) {
                container.style.display = 'none';
                if (info) info.style.display = 'none';
                return;
            }

            if (info) {
                var desde = (paginaActual - 1) * POR_PAGINA + 1;
                var hasta = Math.min(paginaActual * POR_PAGINA, filas().length);
                info.textContent = 'Mostrando ' + desde + '–' + hasta + ' de ' + filas().length + ' membresías';
                info.style.display = 'block';
            }

            var html = '<ul class="pagination-jena">';

            html += '<li class="page-jena-item' + (paginaActual === 1 ? ' disabled' : '') + '">'
                  + '<button class="page-jena-btn" data-p="' + (paginaActual - 1) + '" aria-label="Anterior">'
                  + '<i class="bi bi-chevron-left"></i></button></li>';

            for (var i = 1; i <= totalPaginas; i++) {
                html += '<li class="page-jena-item' + (i === paginaActual ? ' active' : '') + '">'
                      + '<button class="page-jena-btn" data-p="' + i + '">' + i + '</button></li>';
            }

            html += '<li class="page-jena-item' + (paginaActual === totalPaginas ? ' disabled' : '') + '">'
                  + '<button class="page-jena-btn" data-p="' + (paginaActual + 1) + '" aria-label="Siguiente">'
                  + '<i class="bi bi-chevron-right"></i></button></li>';

            html += '</ul>';
            container.innerHTML = html;
            container.style.display = 'flex';

            container.querySelectorAll('.page-jena-btn[data-p]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    irAPagina(parseInt(this.getAttribute('data-p')));
                });
            });
        }

        function irAPagina(p) {
            var total = Math.ceil(filas().length / POR_PAGINA) || 1;
            if (p < 1 || p > total) return;
            paginaActual = p;
            aplicar();
        }

        function aplicar() {
            var rows  = filasTodas(); // all rows
            var visibles = filas();   // filtered and visible rows
            var total = Math.max(1, Math.ceil(visibles.length / POR_PAGINA));

            if (!esMobile()) {
                // Mostrar solo las filas que coinciden con el filtro en escritorio
                rows.forEach(function (r) {
                    r.style.display = (r.dataset.visible !== '0') ? '' : 'none';
                });
                // ocultar controles mobile
                var c = document.getElementById('paginacion-mobile-membresias');
                var i = document.getElementById('paginacionInfoMembresias');
                if (c) c.style.display = 'none';
                if (i) i.style.display = 'none';
                return;
            }

            // Mobile: paginar solo entre las filas visibles
            rows.forEach(function (r) { r.style.display = 'none'; });
            var inicio = (paginaActual - 1) * POR_PAGINA;
            var fin = inicio + POR_PAGINA;
            visibles.forEach(function (r, idx) {
                r.style.display = (idx >= inicio && idx < fin) ? '' : 'none';
            });

            renderPaginacion(total);
        }

        // Inicializar visibilidad en todas las filas
        filasTodas().forEach(function (r) { r.dataset.visible = '1'; });

        // Función pública para aplicar filtros (Plan, Estado, Cliente)
        window.aplicarFiltrosMembresias = function () {
            var selPlan = document.getElementById('filtroPlan');
            var selEstado = document.getElementById('filtroEstadoMembresias');
            var selCliente = document.getElementById('filtroCliente');

            var plan = selPlan ? selPlan.value.toLowerCase() : '';
            var estado = selEstado ? selEstado.value.toLowerCase() : '';
            var cliente = selCliente ? selCliente.value.toLowerCase() : '';

            filasTodas().forEach(function (r) {
                var rPlan = (r.getAttribute('data-plan') || '').toLowerCase();
                var rEstado = (r.getAttribute('data-estado') || '').toLowerCase();
                var rCliente = (r.getAttribute('data-cliente') || '').toLowerCase();

                var matchPlan = !plan || rPlan === plan;
                var matchEstado = !estado || rEstado === estado;
                var matchCliente = !cliente || rCliente === cliente;

                r.dataset.visible = (matchPlan && matchEstado && matchCliente) ? '1' : '0';
            });

            paginaActual = 1;
            aplicar();
        };

        window.resetearFiltrosMembresias = function () {
            document.getElementById('filtroPlan').value = '';
            document.getElementById('filtroEstadoMembresias').value = '';
            document.getElementById('filtroCliente').value = '';
            filasTodas().forEach(function (r) { r.dataset.visible = '1'; });
            paginaActual = 1;
            aplicar();
        };

        aplicar();

        var resizeTimer;
        window.addEventListener('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                paginaActual = 1;
                aplicar();
            }, 150);
        });
    }());
</script>
}
