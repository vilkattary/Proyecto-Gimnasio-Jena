@model IEnumerable<GimnasioJena.Abstracciones.Modelos.Membresias.MembresiaListadoDto>

@{
    ViewBag.Title = "Membresías";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="page-title">Membresías</h1>
        <p class="text-muted">
            Administración general de las membresías asignadas a los clientes.
        </p>
    </div>

    <div class="d-flex justify-content-end mb-4">
        <a href="@Url.Action("Create", "Membresias")" class="btn btn-action">
            <i class="bi bi-plus-circle me-1"></i>
            Registrar Membresía
        </a>
    </div>

    <div class="info-card">

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">
                @TempData["MensajeExito"]
            </div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">
                @TempData["MensajeError"]
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                No hay membresías registradas.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-jena tabla-membresias">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Cliente</th>
                            <th>Plan</th>
                            <th class="col-mobile-oculto">Precio</th>
                            <th>Estado</th>
                            <th class="col-mobile-oculto">Inicio</th>
                            <th class="col-mobile-oculto">Fin</th>
                            <th class="col-mobile-oculto">Clases</th>
                            <th class="text-center col-mobile-oculto">Acciones</th>
                        </tr>
                    </thead>

                    <tbody id="cuerpoTablaMembresias">

                        @foreach (var m in Model)
                        {
                            <tr>

                                <td data-label="#">@m.idMembresiaCliente</td>

                                <td data-label="Cliente">@m.nombreCliente</td>

                                <td data-label="Plan">@m.nombrePlan</td>

                                <td data-label="Precio" class="col-mobile-oculto">
                                    ₡ @m.precio.ToString("N2")
                                </td>

                                <td data-label="Estado">

                                    @if (m.estadoMembresia == "Activa")
                                    {
                                        <span class="badge bg-success">
                                            @m.estadoMembresia
                                        </span>
                                    }
                                    else if (m.estadoMembresia == "Inactiva")
                                    {
                                        <span class="badge bg-secondary">
                                            @m.estadoMembresia
                                        </span>
                                    }
                                    else if (m.estadoMembresia == "Vencida")
                                    {
                                        <span class="badge bg-danger">
                                            @m.estadoMembresia
                                        </span>
                                    }
                                    else if (m.estadoMembresia == "Suspendida")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @m.estadoMembresia
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">
                                            @m.estadoMembresia
                                        </span>
                                    }

                                </td>

                                <td data-label="Inicio" class="col-mobile-oculto">
                                    @m.fechaInicio.ToString("dd/MM/yyyy")
                                </td>

                                <td data-label="Fin" class="col-mobile-oculto">
                                    @m.fechaFin.ToString("dd/MM/yyyy")
                                </td>

                                <td data-label="Clases" class="col-mobile-oculto">

                                    @(m.clasesDisponibles.HasValue
                                        ? m.clasesDisponibles.Value.ToString()
                                        : "Ilimitadas")

                                </td>

                                <td class="text-center col-mobile-oculto">

                                    <a href="@Url.Action(
                 "Details",
                 "Membresias",
                 new { id = m.idMembresiaCliente })"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                        Detalle
                                    </a>

                                    <a href="@Url.Action(
                 "Edit",
                 "Membresias",
                 new { id = m.idMembresiaCliente })"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-square"></i>
                                        Editar
                                    </a>

                                    @if (m.fechaFin.Date <= DateTime.Today)
                                    {
                                        using (Html.BeginForm(
                                            "Renovar",
                                            "Membresias",
                                            FormMethod.Post,
                                            new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@m.idMembresiaCliente" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    onclick="return confirm('¿Deseas renovar esta membresía? Al confirmar, el nuevo periodo iniciará hoy y se restablecerán las clases disponibles según el plan.')">
                                                <i class="bi bi-arrow-clockwise"></i>
                                                Renovar
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled
                                                title="La membresía podrá renovarse el día de su vencimiento">
                                            <i class="bi bi-clock"></i>
                                            Vigente
                                        </button>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            </div>

            <p class="paginacion-info" id="paginacionInfoMembresias"></p>
            <div id="paginacion-mobile-membresias" class="paginacion-mobile-wrapper"></div>
        }

    </div>

</div>

@section Scripts {
<script>
    /* ── Paginación mobile – Membresías ─────────────────────── */
    (function () {
        var POR_PAGINA = 5;
        var paginaActual = 1;

        function esMobile() { return window.innerWidth < 768; }

        function filas() {
            return Array.from(document.querySelectorAll('#cuerpoTablaMembresias tr'));
        }

        function renderPaginacion(totalPaginas) {
            var container = document.getElementById('paginacion-mobile-membresias');
            var info      = document.getElementById('paginacionInfoMembresias');
            if (!container) return;

            if (!esMobile() || totalPaginas <= 1) {
                container.style.display = 'none';
                if (info) info.style.display = 'none';
                return;
            }

            if (info) {
                var desde = (paginaActual - 1) * POR_PAGINA + 1;
                var hasta = Math.min(paginaActual * POR_PAGINA, filas().length);
                info.textContent = 'Mostrando ' + desde + '–' + hasta + ' de ' + filas().length + ' membresías';
                info.style.display = 'block';
            }

            var html = '<ul class="pagination-jena">';

            html += '<li class="page-jena-item' + (paginaActual === 1 ? ' disabled' : '') + '">'
                  + '<button class="page-jena-btn" data-p="' + (paginaActual - 1) + '" aria-label="Anterior">'
                  + '<i class="bi bi-chevron-left"></i></button></li>';

            for (var i = 1; i <= totalPaginas; i++) {
                html += '<li class="page-jena-item' + (i === paginaActual ? ' active' : '') + '">'
                      + '<button class="page-jena-btn" data-p="' + i + '">' + i + '</button></li>';
            }

            html += '<li class="page-jena-item' + (paginaActual === totalPaginas ? ' disabled' : '') + '">'
                  + '<button class="page-jena-btn" data-p="' + (paginaActual + 1) + '" aria-label="Siguiente">'
                  + '<i class="bi bi-chevron-right"></i></button></li>';

            html += '</ul>';
            container.innerHTML = html;
            container.style.display = 'flex';

            container.querySelectorAll('.page-jena-btn[data-p]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    irAPagina(parseInt(this.getAttribute('data-p')));
                });
            });
        }

        function irAPagina(p) {
            var total = Math.ceil(filas().length / POR_PAGINA);
            if (p < 1 || p > total) return;
            paginaActual = p;
            aplicar();
        }

        function aplicar() {
            var rows  = filas();
            var total = Math.ceil(rows.length / POR_PAGINA);

            if (!esMobile()) {
                rows.forEach(function (r) { r.style.display = ''; });
                var c = document.getElementById('paginacion-mobile-membresias');
                var i = document.getElementById('paginacionInfoMembresias');
                if (c) c.style.display = 'none';
                if (i) i.style.display = 'none';
                return;
            }

            var desde = (paginaActual - 1) * POR_PAGINA;
            var hasta = desde + POR_PAGINA;
            rows.forEach(function (r, idx) {
                r.style.display = (idx >= desde && idx < hasta) ? '' : 'none';
            });
            renderPaginacion(total);
        }

        aplicar();

        var resizeTimer;
        window.addEventListener('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                paginaActual = 1;
                aplicar();
            }, 150);
        });
    }());
</script>
}
